# Pick the two cut points that most evenly balance the three groups
best_split <- function(parts) {
n <- length(parts)
if (n == 0) return(c(NA_character_, NA_character_, NA_character_))
if (n == 1) return(c(parts[1], NA_character_, NA_character_))
if (n == 2) return(c(parts[1], parts[2], NA_character_))
lens <- nchar(parts)
best <- NULL
best_score <- Inf
for (i in 1:(n - 2)) {
for (j in (i + 1):(n - 1)) {
g <- c(sum(lens[1:i]), sum(lens[(i + 1):j]), sum(lens[(j + 1):n]))
score <- sum((g - mean(g))^2)
if (score < best_score) {
best_score <- score
best <- c(i, j)
}
}
}
i <- best[1]
j <- best[2]
c(
paste0(parts[1:i], collapse = ""),
paste0(parts[(i + 1):j], collapse = ""),
paste0(parts[(j + 1):n], collapse = "")
)
}
original <- bullets1$BULLET1 # keep for the check below
bullets1 <- bullets1 %>%
mutate(
.pieces = map(BULLET1, ~ best_split(split_sentences(.x))),
BULLET2 = map_chr(.pieces, 2),
BULLET3 = map_chr(.pieces, 3),
BULLET1 = map_chr(.pieces, 1)
) %>%
select(-.pieces)
bullets2 <- select(bullets1, PFF_ID, BULLET2)
bullets3 <- select(bullets1, PFF_ID, BULLET3)
bullets1 <- select(bullets1, PFF_ID, BULLET1)
players$pff_player_identifier <- as.character(players$pff_player_identifier)
idp_players$pff_player_identifier <- as.character(
idp_players$pff_player_identifier
)
players$name <- ifelse(
players$position == 'DEF',
paste(players$current_team, " DST", sep = ""),
players$name
)
names(players)[names(players) == "pff_player_identifier"] <- "pff_id"
names(players)[names(players) == "current_team"] <- "team"
names(idp_players)[names(idp_players) == "pff_player_identifier"] <- "pff_id"
names(idp_players)[names(idp_players) == "current_team"] <- "team"
#This is for in season rankings
shares_week_ppr <- shares %>%
select(position, week_ppr_proj) %>%
group_by(position) %>%
mutate(w_ppr_rank = dplyr::row_number(dplyr::desc(week_ppr_proj))) %>%
ungroup()
shares_week_half <- shares %>%
select(position, week_half_proj) %>%
group_by(position) %>%
mutate(week_rank = dplyr::row_number(dplyr::desc(week_half_proj))) %>%
ungroup()
shares_week_standard <- shares %>%
select(position, week_standard_proj) %>%
group_by(position) %>%
mutate(
w_standard_rank = dplyr::row_number(dplyr::desc(week_standard_proj))
) %>%
ungroup()
week_ppr <- players %>%
filter(
(players$position == 'QB' & w_ppr_rank <= number_games * 2) |
(players$position == 'RB' & w_ppr_rank <= rb_players) |
(players$position == 'WR' & w_ppr_rank <= wr_players) |
(players$position == 'TE' & w_ppr_rank <= te_players)
) %>%
select(pff_id, position, name, team, w_ppr_rank) %>%
mutate(week_id = current_week_input) %>%
inner_join(shares_week_ppr, by = c("position", "w_ppr_rank")) %>%
arrange(desc(week_ppr_proj)) %>%
select(-w_ppr_rank, -week_ppr_proj)
article <- players %>%
filter(
(position == 'QB' & w_ppr_rank <= number_games * 2) |
(position == 'RB' & w_ppr_rank <= rb_players) |
(position == 'WR' & w_ppr_rank <= wr_players) |
(position == 'TE' & w_ppr_rank <= te_players) |
(position == 'K' & w_ppr_rank <= number_games * 2) |
(position == 'DEF' & w_ppr_rank <= number_games * 2)
) %>%
select(
position,
name,
team,
w_ppr_rank,
opponent,
start_time_est,
home_away,
injury,
injury_status,
pff_player_url,
team_url,
opponent_url
) %>%
left_join(shares_week_ppr, by = c("position", "w_ppr_rank")) %>%
arrange(desc(week_ppr_proj)) %>%
mutate(
overall_rank = if_else(
position %in% c('QB', 'RB', 'WR', 'TE'),
as.character(cumsum(position %in% c('QB', 'RB', 'WR', 'TE'))),
""
)
) %>%
rename(position_rank = w_ppr_rank) %>%
select(
overall_rank,
position_rank,
position,
name,
team,
everything(),
-week_ppr_proj
)
week_half <- players %>%
filter(
(players$position == 'QB' & week_rank <= number_games * 2) |
(players$position == 'RB' & week_rank <= rb_players) |
(players$position == 'WR' & week_rank <= wr_players) |
(players$position == 'TE' & week_rank <= te_players)
) %>%
select(pff_id, position, name, team, week_rank) %>%
mutate(week_id = current_week_input) %>%
inner_join(shares_week_half, by = c("position", "week_rank")) %>%
arrange(desc(week_half_proj)) %>%
select(-week_rank, -week_half_proj)
week_standard <- players %>%
filter(
(players$position == 'QB' & w_standard_rank <= number_games * 2) |
(players$position == 'RB' & w_standard_rank <= rb_players) |
(players$position == 'WR' & w_standard_rank <= wr_players) |
(players$position == 'TE' & w_standard_rank <= te_players)
) %>%
select(pff_id, position, name, team, w_standard_rank) %>%
mutate(week_id = current_week_input) %>%
inner_join(shares_week_standard, by = c("position", "w_standard_rank")) %>%
arrange(desc(week_standard_proj)) %>%
select(-w_standard_rank, -week_standard_proj)
week_k <- players %>%
filter(players$position == 'K') %>%
select(pff_id, position, name, team, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
slice_head(n = number_games * 2) %>%
select(-week_rank)
week_def <- players %>%
filter(players$position == 'DEF') %>%
select(pff_id, position, name, team, week_rank) %>%
mutate(
week_id = current_week_input,
pff_id = sub("^pff-team-", "", as.character(pff_id))
) %>%
arrange(week_rank) %>%
slice_head(n = number_games * 2) %>%
select(-week_rank)
week_idp <- idp_players %>%
arrange(week_rank) %>%
slice_head(n = 360)
week_dl <- week_idp %>%
filter(week_idp$pff_position %in% c('DI', 'ED')) %>%
mutate(position = pff_position) %>%
select(pff_id, name, team, position, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
select(-week_rank)
week_lb <- week_idp %>%
filter(week_idp$pff_position %in% c('LB')) %>%
mutate(position = pff_position) %>%
select(pff_id, name, team, position, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
select(-week_rank)
week_db <- week_idp %>%
filter(week_idp$pff_position %in% c('CB', 'S')) %>%
mutate(position = pff_position) %>%
select(pff_id, name, team, position, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
select(-week_rank)
idp_article <- week_idp %>%
mutate(position = pff_position) %>%
select(
pff_position,
idp_position,
name,
team,
week_rank,
opponent,
start_time_est,
home_away,
injury,
injury_status,
pff_player_url,
team_url,
opponent_url
) %>%
rename(overall_rank = week_rank) %>%
select(
overall_rank,
pff_position,
idp_position,
name,
team,
everything()
)
