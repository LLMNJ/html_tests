'            <th></th>',
'          </tr>',
'        </thead>',
'        <tbody>',
tbody_html,
'        </tbody>',
'      </table>',
'    </div>',
'  </div>',
'  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>',
'  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>',
'  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>',
'  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>',
'  <script>',
'    $(document).ready(function() {',
'',
'      function dtExportText(data) {',
'        try {',
'          return $("<div>").html(data).text().trim();',
'        } catch(e) {',
'          return (data || "").toString().trim();',
'        }',
'      }',
'',
'      function dtExportHeader(data, columnIdx, node) {',
'        var desktopLabel = $(node).find(".desktop-label").text();',
'        return desktopLabel || $(node).text().trim();',
'      }',
'',
'      var table = $("#example").DataTable({',
'        dom: "B t",',
'        autoWidth: false,',
'        columnDefs: [',
'          { targets: 0, width: "8%" },',
'          { targets: 1, width: "10%" },',
'          { targets: 2, width: "35%" },',
'          { targets: 3, width: "30%" }',
'        ],',
'        buttons: [',
'          {',
'            extend: "copyHtml5",',
'            text: "<span class=\\"desktop-btn-label\\">Copy</span><span class=\\"mobile-btn-label\\">Copy</span>",',
sprintf('            title: "%s",', table_title),
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            }',
'          },',
'          {',
'            extend: "csvHtml5",',
'            text: "<span class=\\"desktop-btn-label\\">Download CSV</span><span class=\\"mobile-btn-label\\">CSV</span>",',
sprintf('            filename: "%s",', csv_filename),
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            }',
'          },',
'          {',
'            extend: "excelHtml5",',
'            text: "<span class=\\"desktop-btn-label\\">Download Excel</span><span class=\\"mobile-btn-label\\">Excel</span>",',
sprintf('            filename: "%s",', csv_filename),
sprintf('            title: "%s",', table_title),
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            }',
'          },',
'          {',
'            extend: "print",',
'            text: "<span class=\\"desktop-btn-label\\">Print</span><span class=\\"mobile-btn-label\\">Print</span>",',
'            title: "",',
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            },',
'            customize: function(win) {',
sprintf('              var printTitle = "%s";', table_title),
'              win.document.title = printTitle;',
'              var columnsPerPage = 3;',
'              var rowsPerColumn = 85;',
'              var rowsPerPage = columnsPerPage * rowsPerColumn;',
'              var $body = $(win.document.body);',
'              var $originalTable = $body.find("table").first();',
'',
'              function escapeHtml(x) {',
'                return $("<div>").text(x == null ? "" : x).html();',
'              }',
'',
'              var headers = [];',
'              $originalTable.find("thead tr").first().find("th").each(function(i) {',
'                if (i === 0) headers.push("Rank");',
'                else if (i === 1) headers.push("Pos");',
'                else headers.push($(this).text().trim());',
'              });',
'',
'              var rows = [];',
'              $originalTable.find("tbody tr").each(function() {',
'                var row = [];',
'                $(this).find("td").each(function() {',
'                  row.push($(this).text().trim());',
'                });',
'                if (row.length) rows.push(row);',
'              });',
'',
'              function makeMiniTable(headers, rowsChunk) {',
'                if (!rowsChunk.length) return "<div class=\\"print-column empty-column\\"></div>";',
'                var html = "<div class=\\"print-column\\"><table class=\\"print-mini-table\\"><thead><tr>";',
'                headers.forEach(function(h) { html += "<th>" + escapeHtml(h) + "</th>"; });',
'                html += "</tr></thead><tbody>";',
'                rowsChunk.forEach(function(row) {',
'                  html += "<tr>";',
'                  row.forEach(function(cell) { html += "<td>" + escapeHtml(cell) + "</td>"; });',
'                  html += "</tr>";',
'                });',
'                html += "</tbody></table></div>";',
'                return html;',
'              }',
'',
'              var html = "";',
'',
'              for (var i = 0; i < rows.length; i += rowsPerPage) {',
'                html += "<div class=\\"print-page-wrapper\\">";',
'                html += "<div class=\\"print-title\\">" + escapeHtml(printTitle) + "</div>";',
'                html += "<div class=\\"print-page\\">";',
'                for (var c = 0; c < columnsPerPage; c++) {',
'                  var start = i + c * rowsPerColumn;',
'                  var end = start + rowsPerColumn;',
'                  html += makeMiniTable(headers, rows.slice(start, end));',
'                }',
'                html += "</div>";',
'                html += "</div>";',
'              }',
'',
'              $body.html(html);',
'',
'              $(win.document.head).append(',
'                "<style>" +',
'                "@page { size: portrait; margin: 0.12in; }" +',
'                "body { font-family: Archivo, Arial, sans-serif; margin: 0; color: #000; }" +',
'                ".print-title { font-size: 11pt; font-weight: 700; text-align: center; margin-bottom: 5px; }" +',
'                ".print-page-wrapper { page-break-after: always; break-after: page; }" +',
'                ".print-page-wrapper:last-child { page-break-after: auto; break-after: auto; }" +',
'                ".print-page { display: flex; gap: 8px; width: 100%; align-items: flex-start; }" +',
'                ".print-column { width: 33.333%; }" +',
'                ".empty-column { display: block; }" +',
'                ".print-mini-table { width: 100%; border-collapse: collapse; table-layout: fixed; }" +',
'                ".print-mini-table th, .print-mini-table td { font-size: 7.2pt; line-height: 1.03; padding: 0.4px 0.65px; border-bottom: 0.2px solid #ddd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }" +',
'                ".print-mini-table th { font-weight: 700; border-bottom: 0.5px solid #999; text-align: center; }" +',
'                ".print-mini-table th:nth-child(1), .print-mini-table td:nth-child(1) { width: 12%; text-align: center; }" +',
'                ".print-mini-table th:nth-child(2), .print-mini-table td:nth-child(2) { width: 12%; text-align: center; }" +',
'                ".print-mini-table th:nth-child(3), .print-mini-table td:nth-child(3) { width: 47%; text-align: left; }" +',
'                ".print-mini-table th:nth-child(4), .print-mini-table td:nth-child(4) { width: 29%; text-align: left; }" +',
'                "</style>"',
'              );',
'            }',
'          },',
'          {',
'            text: "<span class=\\"desktop-btn-label\\">Clear Filters</span><span class=\\"mobile-btn-label\\">Clear</span>",',
'            action: function() {',
'              $("#pff-cheat-sheet-table .filter-row input").val("");',
'              $("#pff-cheat-sheet-table .filter-row select").val("");',
'              table.search("").columns().search("");',
'              table.draw();',
'            }',
'          }',
'        ],',
'        paging: false,',
'        ordering: true,',
'        info: false,',
'        orderCellsTop: true',
'      });',
'',
'      // Open player/team links in a new tab',
'      function retargetLinks() {',
'        $("#pff-cheat-sheet-table #example a").attr("target", "_blank").attr("rel", "noopener noreferrer");',
'      }',
'      retargetLinks();',
'      table.on("draw", retargetLinks);',
'',
'      // Prevent clicks inside filter controls from triggering column sorting',
'      $("#pff-cheat-sheet-table #example thead tr.filter-row").on("click", "input, select", function(e) {',
'        e.stopPropagation();',
'      });',
'',
'      // name filter input (column 2)',
'      $("#pff-cheat-sheet-table .filter-row input").on("keyup change", function() {',
'        table.column(2).search(this.value).draw();',
'      });',
'',
'      // dropdowns for position and team',
'      function addDropdown(colIndex, placeholder) {',
'        var col = table.column(colIndex);',
'        var vals = col.data().map(function(d) { return $("<div>").html(d).text(); }).toArray();',
'        vals = Array.from(new Set(vals)).sort();',
'        var sel = $("<select class=\\"form-select form-select-sm text-center\\"></select>");',
'        sel.append($("<option>").val("").text(placeholder));',
'        $.each(vals, function(_, v) { sel.append($("<option>").val(v).text(v)); });',
'        sel.on("change", function() {',
'          col.search(this.value ? "^" + this.value + "$" : "", true, false).draw();',
'        });',
'        $("#pff-cheat-sheet-table #example .filter-row th").eq(colIndex).append(sel);',
'      }',
'',
'      addDropdown(1, "Filter");',
'      addDropdown(3, "Filter");',
'    });',
'  </script>',
'</body>',
'</html>'
)
file_name <- paste(
"/home/nathan/Dropbox/403_article_creation/html/cheat_sheet_html",
league_type,
article_position,
".html",
sep = "_"
)
# Write HTML and CSV to disk
writeLines(html_lines, file_name)
# --- intro section: bullets, intro paragraph, last updated ---
intro_section <- tagList(
tags$ul(
style = "font-family:sans-serif; font-size:11pt;",
lapply(bullets, function(b) tags$li(tags$b(b$prefix), " ", b$body))
),
tags$p(
style = "font-family:sans-serif; font-size:11pt; margin-bottom:1em;",
intro_text
),
tags$p(
style = "font-family:sans-serif; font-size:11pt; margin-bottom:1em;",
tags$b(paste0(
"Last updated: ",
publish_day_of_week,
", ",
publish_month,
" ",
publish_day
))
)
)
# --- simple static table (reuses the `players` df built above) ---
cell_style <- "border:1px solid #999; padding:4px 8px; font-family:sans-serif; font-size:11pt;"
head_style <- paste0(cell_style, " font-weight:bold; background-color:#f2f2f2;")
table_rows <- pmap(
players,
function(rank, position, name, current_team, player_profile_url, url, ...) {
tags$tr(
tags$td(style = cell_style, rank),
tags$td(style = cell_style, position),
tags$td(style = cell_style, tags$a(href = player_profile_url, name)),
tags$td(style = cell_style, tags$a(href = url, current_team))
)
}
)
simple_table <- tags$table(
style = "border:1px solid #999; border-collapse:collapse;",
tags$thead(
tags$tr(
tags$th(style = head_style, "Rank"),
tags$th(style = head_style, "Position"),
tags$th(style = head_style, "Name"),
tags$th(style = head_style, "Team")
)
),
tags$tbody(table_rows)
)
# --- assemble and save the Google-Doc-friendly HTML ---
doc_gdoc <- tags$html(
tags$head(
tags$meta(charset = "UTF-8"),
tags$title(table_title)
),
tags$body(
intro_section,
simple_table
)
)
gdoc_file_name <- paste(
"/home/nathan/Dropbox/403_article_creation/html/cheat_sheet_doc",
league_type,
article_position,
".html",
sep = "_"
)
save_html(doc_gdoc, gdoc_file_name)
# Write HTML and CSV to disk
#writeLines(doc_gdoc, gdoc_file_name)
setwd("~/html_tests")
file_name <- paste(
"~/html_tests/cheat_sheet_html",
league_type,
article_position,
".html",
sep = "_"
)
# Write HTML and CSV to disk
writeLines(html_lines, file_name)
gert::git_add(".") # stage everything
gert::git_commit("Update HTML") # commit staged files
gert::git_push(remote = "origin")
