content <- content %>%
select(all_of(c("player_id", paragraph_cols))) %>%
mutate(player_id = norm_key(player_id)) %>%
filter(!is_blank(player_id)) %>%
distinct(player_id, .keep_all = TRUE)
players$pff_player_identifier <- norm_key(players$pff_player_identifier)
players <- left_join(
x = players,
y = content,
by = c("pff_player_identifier" = "player_id")
)
players$player_profile_url <- ifelse(
is_blank(flat_chr(players$player_profile_url)),
flat_chr(players$pff_player_url),
flat_chr(players$player_profile_url)
)
# Only rankings whose columns actually exist in the sheet.
missing_defs <- Filter(function(rd) !rd$rank %in% names(players), ranking_defs)
if (length(missing_defs) > 0) {
warning(
"Skipping rankings with no column in the sheet: ",
paste(vapply(missing_defs, function(rd) rd$rank, character(1)), collapse = ", ")
)
}
ranking_defs <- Filter(function(rd) rd$rank %in% names(players), ranking_defs)
stopifnot(length(ranking_defs) > 0)
players <- players %>%
mutate(
position = flat_chr(position),
name = flat_chr(name),
full_team = flat_chr(full_team),
across(all_of(paragraph_cols), flat_chr)
) %>%
filter(position %in% position_order)
players$has_writeup <- rowSums(
vapply(paragraph_cols, function(cl) !is_blank(players[[cl]]), logical(nrow(players)))
) > 0
# ---------------------------------------------------------------------------
# Per-ranking order, positional rank and tier
# ---------------------------------------------------------------------------
tiebreak <- if (tiebreak_column %in% names(players)) {
flat_num(players[[tiebreak_column]])
} else {
seq_len(nrow(players))
}
# For each ranking: take the top `limit` rows by rank order, then number them
# 1..N. Numbering by position in the order (rather than reusing the sheet's raw
# value) keeps the displayed rank sensible even where a column repeats values.
rank_data <- list()
for (rd in ranking_defs) {
raw <- flat_num(players[[rd$rank]])
ord <- order(raw, tiebreak, players$name, na.last = NA)
keep <- head(ord, rd$limit)
overall <- rep(NA_integer_, nrow(players))
overall[keep] <- seq_along(keep)
# Positional rank: the cutoff takes a prefix of the overall order, so
# numbering within a position here matches that position's true order.
pos_rank <- rep(NA_integer_, nrow(players))
seen <- integer(0)
for (i in keep) {
ps <- players$position[i]
seen[ps] <- if (is.na(seen[ps])) 1L else seen[ps] + 1L
pos_rank[i] <- seen[ps]
}
tier <- rep(NA_integer_, nrow(players))
if (!is.na(rd$tier) && rd$tier %in% names(players)) {
tv <- flat_num(players[[rd$tier]])
tier[keep] <- as.integer(tv[keep])
}
rank_data[[rd$id]] <- list(
overall = overall,
pos_rank = pos_rank,
tier = tier
)
}
# Keep any player ranked in at least one ranking.
in_any <- Reduce(
`|`,
lapply(ranking_defs, function(rd) !is.na(rank_data[[rd$id]]$overall))
)
players$row_id <- seq_len(nrow(players))
included <- players$row_id[in_any]
message(
"Included ", length(included), " players across ", length(ranking_defs),
" rankings; ", sum(players$has_writeup[in_any]), " have a writeup."
)
player_paragraphs <- function(i) {
paras <- as.character(unlist(players[i, paragraph_cols], use.names = FALSE))
paras[!is_blank(paras)]
}
default_def <- Filter(function(rd) rd$id == default_ranking, ranking_defs)
if (length(default_def) == 0) default_def <- ranking_defs[1]
default_def <- default_def[[1]]
default_ranking <- default_def$id
# ---------------------------------------------------------------------------
# Interactive version - self-contained, responsive, for iframe embed
# ---------------------------------------------------------------------------
# Compact per-player ranking payload: {rankingId: [overall, posRank, tier]}.
rank_json <- vapply(included, function(i) {
parts <- character(0)
for (rd in ranking_defs) {
ri <- rank_data[[rd$id]]
if (!is.na(ri$overall[i])) {
parts <- c(parts, sprintf(
'"%s":[%d,%d,%s]',
rd$id, ri$overall[i], ri$pos_rank[i],
if (is.na(ri$tier[i])) "null" else as.character(ri$tier[i])
))
}
}
paste0("{", paste(parts, collapse = ","), "}")
}, character(1))
positions_present <- position_order[position_order %in% players$position[included]]
ranking_option_html <- {
out <- character(0)
for (grp in unique(vapply(ranking_defs, function(rd) rd$group, character(1)))) {
out <- c(out, sprintf('          <optgroup label="%s">', esc(grp)))
for (rd in Filter(function(r) r$group == grp, ranking_defs)) {
out <- c(out, sprintf(
'            <option value="%s"%s>%s</option>',
esc(rd$id),
if (rd$id == default_ranking) " selected" else "",
esc(rd$label)
))
}
out <- c(out, "          </optgroup>")
}
out
}
pill_html <- c(
'        <button type="button" class="dg-pill is-active" data-pos="">All</button>',
vapply(positions_present, function(ps) {
sprintf(
'        <button type="button" class="dg-pill" data-pos="%s">%s</button>',
esc(ps), esc(ps)
)
}, character(1))
)
player_html <- unlist(lapply(seq_along(included), function(k) {
i <- included[k]
name_html <- if (is_blank(players$player_profile_url[i])) {
esc(players$name[i])
} else {
sprintf(
'<a href="%s" target="_blank" rel="noopener noreferrer">%s</a>',
esc(players$player_profile_url[i]), esc(players$name[i])
)
}
paras <- player_paragraphs(i)
body <- if (length(paras) == 0) {
""
} else {
paste0(
'        <div class="dg-body">',
paste(vapply(paras, function(t) sprintf("<p>%s</p>", esc(t)), character(1)),
collapse = ""),
"</div>"
)
}
c(
sprintf(
'      <article class="dg-player" id="dg-player-%s" data-pos="%s" data-search="%s" data-rk=\'%s\'>',
esc(slugify(paste(players$name[i], players$position[i]))),
esc(players$position[i]),
esc(tolower(paste(players$name[i], players$full_team[i], players$position[i]))),
esc(rank_json[k])
),
'        <h3 class="dg-player-head">',
'          <span class="dg-rank"></span>',
sprintf('          <span class="dg-pos">%s</span>', esc(players$position[i])),
sprintf('          <span class="dg-name">%s</span>', name_html),
sprintf('          <span class="dg-team">%s</span>', esc(players$full_team[i])),
'          <span class="dg-posrank"></span>',
"        </h3>",
body,
"      </article>"
)
}), use.names = FALSE)
intro_bullets_html <- if (length(bullets) == 0) {
character(0)
} else {
c(
'      <ul class="dg-bullets">',
vapply(bullets, function(b) {
sprintf("        <li><strong>%s</strong> %s</li>", esc(b$prefix), esc(b$body))
}, character(1)),
"      </ul>"
)
}
intro_paras_html <- {
ip <- c(intro_text, intro_text_two, intro_text_three)
ip <- ip[!is_blank(ip)]
vapply(ip, function(t) sprintf('      <p class="dg-intro-p">%s</p>', esc(t)),
character(1))
}
html_lines <- c(
"<!DOCTYPE html>",
'<html lang="en">',
"<head>",
'  <meta charset="UTF-8">',
'  <meta name="viewport" content="width=device-width, initial-scale=1">',
sprintf("  <title>%s</title>", esc(article_title)),
'  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&display=swap" rel="stylesheet">',
"  <style>",
"    #pff-draft-guide {",
"      font-family: 'Archivo', Arial, sans-serif;",
"      color: #1a1a1a;",
"      max-width: 900px;",
"      margin: 0 auto;",
"      padding: 0 12px 48px;",
"      line-height: 1.55;",
"      -webkit-text-size-adjust: 100%;",
"    }",
"    #pff-draft-guide * { box-sizing: border-box; }",
"    #pff-draft-guide a { color: #0d6efd; text-decoration: none; }",
"    #pff-draft-guide a:hover { text-decoration: underline; }",
"    #pff-draft-guide .dg-bullets { margin: 0 0 1em; padding-left: 1.1em; font-size: 1rem; }",
"    #pff-draft-guide .dg-bullets li { margin-bottom: 0.4em; }",
"    #pff-draft-guide .dg-intro-p { margin: 0 0 1em; font-size: 1rem; }",
"    #pff-draft-guide .dg-meta { font-size: 0.875rem; color: #666; margin: 0 0 1em; }",
"",
"    #pff-draft-guide .dg-controls {",
"      position: sticky;",
"      top: 0;",
"      z-index: 20;",
"      background: #fff;",
"      border-bottom: 1px solid #e3e3e3;",
"      padding: 8px 0;",
"      margin-bottom: 8px;",
"    }",
"    #pff-draft-guide .dg-select-row { display: flex; gap: 6px; margin-bottom: 6px; }",
"    #pff-draft-guide .dg-select {",
"      flex: 1 1 auto;",
"      min-width: 0;",
"      font: inherit;",
"      font-weight: 600;",
"      font-size: 0.9375rem;",
"      padding: 8px 10px;",
"      border: 1px solid #ccc;",
"      border-radius: 6px;",
"      background: #fff;",
"      color: #1a1a1a;",
"    }",
"    #pff-draft-guide .dg-pills { display: flex; gap: 6px; flex-wrap: wrap; }",
"    #pff-draft-guide .dg-pill {",
"      flex: 1 1 auto;",
"      min-width: 48px;",
"      font: inherit;",
"      font-weight: 600;",
"      font-size: 0.875rem;",
"      padding: 7px 12px;",
"      border: 1px solid #ccc;",
"      border-radius: 999px;",
"      background: #f6f7f8;",
"      color: #1a1a1a;",
"      cursor: pointer;",
"    }",
"    #pff-draft-guide .dg-pill:hover:not(:disabled) { background: #e9ecef; }",
"    #pff-draft-guide .dg-pill.is-active { background: #1a1a1a; border-color: #1a1a1a; color: #fff; }",
"    #pff-draft-guide .dg-pill:disabled { opacity: 0.35; cursor: default; }",
"    #pff-draft-guide .dg-search {",
"      width: 100%;",
"      margin-top: 6px;",
"      padding: 8px 12px;",
"      font: inherit;",
"      font-size: 0.9375rem;",
"      border: 1px solid #ccc;",
"      border-radius: 6px;",
"    }",
"    #pff-draft-guide .dg-count { font-size: 0.8125rem; color: #666; margin: 6px 2px 0; }",
"    #pff-draft-guide .dg-noresults { display: none; padding: 24px 4px; color: #666; }",
"    #pff-draft-guide.is-empty .dg-noresults { display: block; }",
"",
"    #pff-draft-guide .dg-tier-head {",
"      font-size: 1.25rem;",
"      font-weight: 700;",
"      margin: 1.4em 0 0.3em;",
"      padding-bottom: 5px;",
"      border-bottom: 2px solid #1a1a1a;",
"    }",
"    #pff-draft-guide .dg-player { padding: 10px 0 14px; border-top: 1px solid #f0f0f0; }",
"    #pff-draft-guide .dg-player-head {",
"      display: flex;",
"      align-items: baseline;",
"      flex-wrap: wrap;",
"      gap: 4px 8px;",
"      font-size: 1.125rem;",
"      font-weight: 700;",
"      margin: 0 0 0.5em;",
"    }",
"    #pff-draft-guide .dg-rank {",
"      flex: 0 0 auto;",
"      min-width: 32px;",
"      font-size: 0.8125rem;",
"      font-weight: 700;",
"      color: #fff;",
"      background: #555;",
"      border-radius: 4px;",
"      padding: 2px 7px;",
"      text-align: center;",
"    }",
"    #pff-draft-guide .dg-pos {",
"      flex: 0 0 auto;",
"      font-size: 0.75rem;",
"      font-weight: 700;",
"      letter-spacing: 0.03em;",
"      color: #444;",
"      background: #eef0f2;",
"      border-radius: 4px;",
"      padding: 2px 6px;",
"    }",
"    #pff-draft-guide .dg-team { font-size: 0.875rem; font-weight: 400; color: #666; }",
"    #pff-draft-guide .dg-posrank { font-size: 0.75rem; font-weight: 600; color: #888; }",
"    #pff-draft-guide .dg-body p { margin: 0 0 0.85em; font-size: 1rem; }",
"    #pff-draft-guide .dg-body p:last-child { margin-bottom: 0; }",
"",
"    @media (max-width: 576px) {",
"      #pff-draft-guide { padding: 0 4px 32px; line-height: 1.5; }",
"      #pff-draft-guide .dg-pill { padding: 7px 9px; font-size: 0.875rem; min-width: 0; }",
"      #pff-draft-guide .dg-tier-head { font-size: 1.125rem; }",
"      #pff-draft-guide .dg-player-head { font-size: 1.0625rem; }",
"      #pff-draft-guide .dg-body p { font-size: 0.9375rem; }",
"    }",
"",
"    @media (prefers-color-scheme: dark) {",
"      #pff-draft-guide { color: #e8e8e8; }",
"      #pff-draft-guide .dg-controls { background: #17181a; border-bottom-color: #333; }",
"      #pff-draft-guide .dg-pill { background: #232427; border-color: #3a3b3f; color: #e8e8e8; }",
"      #pff-draft-guide .dg-pill.is-active { background: #e8e8e8; border-color: #e8e8e8; color: #17181a; }",
"      #pff-draft-guide .dg-select, #pff-draft-guide .dg-search { background: #232427; border-color: #3a3b3f; color: #e8e8e8; }",
"      #pff-draft-guide .dg-tier-head { border-bottom-color: #e8e8e8; }",
"      #pff-draft-guide .dg-player { border-top-color: #232427; }",
"      #pff-draft-guide .dg-pos { background: #2c2d30; color: #ccc; }",
"      #pff-draft-guide a { color: #6ea8fe; }",
"    }",
"",
"    @media print {",
"      #pff-draft-guide .dg-controls { display: none !important; }",
"      #pff-draft-guide a { color: #000; text-decoration: none; }",
"    }",
"  </style>",
"</head>",
"<body>",
'  <div id="pff-draft-guide">',
'    <div class="dg-intro">',
intro_bullets_html,
intro_paras_html,
if (nzchar(last_updated)) {
sprintf('      <p class="dg-meta"><strong>%s</strong></p>', esc(last_updated))
} else {
character(0)
},
"    </div>",
'    <div class="dg-controls">',
'      <div class="dg-select-row">',
'        <select class="dg-select" aria-label="Ranking set">',
ranking_option_html,
"        </select>",
"      </div>",
'      <div class="dg-pills">',
pill_html,
"      </div>",
'      <input type="search" class="dg-search" placeholder="Search by name or team" aria-label="Search players">',
'      <p class="dg-count"></p>',
"    </div>",
'    <p class="dg-noresults">No players match that search.</p>',
'    <div class="dg-list">',
player_html,
"    </div>",
"  </div>",
"  <script>",
"  (function () {",
'    var root = document.getElementById("pff-draft-guide");',
"    if (!root) return;",
'    var list = root.querySelector(".dg-list");',
'    var select = root.querySelector(".dg-select");',
'    var search = root.querySelector(".dg-search");',
'    var countEl = root.querySelector(".dg-count");',
'    var pills = Array.prototype.slice.call(root.querySelectorAll(".dg-pill"));',
"",
"    // Parse each player's ranking payload once, then sort in memory and",
"    // re-append the existing nodes rather than rebuilding any markup.",
"    var items = Array.prototype.slice.call(",
'      root.querySelectorAll(".dg-player")',
"    ).map(function (el) {",
"      return {",
"        el: el,",
"        pos: el.dataset.pos,",
'        s: el.dataset.search || "",',
"        rk: JSON.parse(el.dataset.rk),",
'        rankEl: el.querySelector(".dg-rank"),',
'        posRankEl: el.querySelector(".dg-posrank")',
"      };",
"    });",
"",
'    var activePos = "";',
"",
"    function setActivePos(pos) {",
"      activePos = pos;",
"      pills.forEach(function (p) {",
'        p.classList.toggle("is-active", p.dataset.pos === pos);',
"      });",
"    }",
"",
"    function render() {",
"      var key = select.value;",
"      var q = search.value.trim().toLowerCase();",
"",
"      // Ranked in the chosen set, then narrowed by search.",
"      var ranked = items.filter(function (it) {",
"        if (!(key in it.rk)) return false;",
"        if (q && it.s.indexOf(q) === -1) return false;",
"        return true;",
"      });",
"",
"      // Position counts come from that set, so a pill can be disabled when",
"      // the chosen ranking has nobody at that position.",
"      var counts = {};",
"      ranked.forEach(function (it) {",
"        counts[it.pos] = (counts[it.pos] || 0) + 1;",
"      });",
"      pills.forEach(function (p) {",
"        var pos = p.dataset.pos;",
"        if (!pos) return;",
"        p.disabled = !counts[pos];",
"      });",
"      if (activePos && !counts[activePos]) setActivePos(\"\");",
"",
"      var shown = activePos",
"        ? ranked.filter(function (it) { return it.pos === activePos; })",
"        : ranked;",
"",
"      shown.sort(function (a, b) { return a.rk[key][0] - b.rk[key][0]; });",
"",
"      var frag = document.createDocumentFragment();",
"      var lastTier = null;",
"      shown.forEach(function (it) {",
"        var entry = it.rk[key];",
"        var tier = entry[2];",
"        if (tier !== null && tier !== lastTier) {",
'          var h = document.createElement("div");',
'          h.className = "dg-tier-head";',
'          h.textContent = "Tier " + tier;',
"          frag.appendChild(h);",
"          lastTier = tier;",
"        }",
"        it.rankEl.textContent = entry[0];",
"        it.posRankEl.textContent = it.pos + entry[1];",
"        frag.appendChild(it.el);",
"      });",
"",
"      while (list.firstChild) list.removeChild(list.firstChild);",
"      list.appendChild(frag);",
"",
'      root.classList.toggle("is-empty", shown.length === 0);',
"      countEl.textContent =",
'        shown.length + (shown.length === 1 ? " player" : " players") +',
'        " \\u00b7 " + select.options[select.selectedIndex].text;',
"    }",
"",
'    select.addEventListener("change", render);',
"",
"    pills.forEach(function (pill) {",
'      pill.addEventListener("click", function () {',
"        if (pill.disabled) return;",
"        setActivePos(pill.dataset.pos);",
"        render();",
"        if (root.scrollIntoView) {",
'          root.scrollIntoView({ behavior: "smooth", block: "start" });',
"        }",
"      });",
"    });",
"",
"    var timer = null;",
'    search.addEventListener("input", function () {',
"      clearTimeout(timer);",
"      timer = setTimeout(render, 120);",
"    });",
"",
"    render();",
"  })();",
"  </script>",
"</body>",
"</html>"
)
# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# One file, carrying every ranking - so it is no longer named after one.
page_basename <- "draft_guide.html"
for (dir in output_dirs) {
writeLines(html_lines, file.path(dir, page_basename))
}
message(
"Wrote ", page_basename, " (", length(included), " players, ",
length(ranking_defs), " rankings) to:\n  ",
paste(output_dirs, collapse = "\n  ")
)
setwd(git_dir)
if (push_to_git) {
gert::git_add(".")
# Re-running without changing the sheets regenerates a byte-identical file,
# which stages nothing and makes git_commit() error out. Only commit when
# there is actually something staged, but still push in case an earlier
# commit was made and the push didn't go through.
if (nrow(gert::git_status(staged = TRUE)) > 0) {
gert::git_commit("Update draft guide HTML")
} else {
message("html_tests: embed file unchanged, nothing new to commit.")
}
gert::git_push(remote = "origin")
}
