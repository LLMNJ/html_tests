'        width: 8%; max-width: 30px; white-space: nowrap; text-align: left; padding-right: 12px;',
'      }',
'      #pff-cheat-sheet-table #example th:nth-child(2), #pff-cheat-sheet-table #example td:nth-child(2) {',
'        width: 10%; max-width: 35px; white-space: nowrap; text-align: left; padding-right: 12px;',
'      }',
'      #pff-cheat-sheet-table #example th:nth-child(3), #pff-cheat-sheet-table #example td:nth-child(3) {',
'        width: 35%; max-width: 100px; word-wrap: break-word; white-space: normal;',
'      }',
'      #pff-cheat-sheet-table #example th:nth-child(4), #pff-cheat-sheet-table #example td:nth-child(4) {',
'        width: 30%; max-width: 70px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;',
'      }',
'      #pff-cheat-sheet-table .desktop-label { display: none; }',
'      #pff-cheat-sheet-table .mobile-label { display: inline; }',
'    }',
'    @media print {',
'      #pff-cheat-sheet-table .dt-buttons, #pff-cheat-sheet-table #example thead tr.filter-row { display: none !important; }',
'      body { padding: 0 !important; }',
'      #pff-cheat-sheet-table #example { table-layout: fixed; width: 100%; }',
'      #pff-cheat-sheet-table #example th, #pff-cheat-sheet-table #example td { font-size: 6pt; line-height: 1.02; padding: 1px 2px; }',
'      #pff-cheat-sheet-table #example a { color: #000; text-decoration: none; }',
'    }',
'  </style>',
'</head>',
'<body class="p-4">',
'  <div id="pff-cheat-sheet-table">',
'    <div class="table-responsive">',
'      <table id="example" class="table table-striped table-hover">',
'        <thead class="table-light">',
'          <tr>',
'            <th><span class="desktop-label">Rank</span><span class="mobile-label">Rk.</span></th>',
'            <th><span class="desktop-label">Position</span><span class="mobile-label">Pos.</span></th>',
'            <th>Name</th>',
'            <th>Team</th>',
'          </tr>',
