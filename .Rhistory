),
{
intro_paras <- c(intro_text, intro_text_two, intro_text_three)
intro_paras <- intro_paras[!is_blank(intro_paras)]
lapply(intro_paras, function(txt) tags$p(style = p_style, txt))
},
if (nzchar(last_updated)) {
tags$p(style = p_style, tags$b(last_updated))
},
tags$p(
style = paste0(body_font, " margin-bottom:1em;"),
tags$b("Jump to: "),
lapply(seq_along(positions_present), function(i) {
pos <- positions_present[i]
tagList(
tags$a(href = paste0("#dg-", tolower(pos)), position_labels[[pos]]),
if (i < length(positions_present)) " | " else NULL
)
})
),
hr_line
)
render_position_static <- function(pos) {
pos_players <- players %>% filter(position == pos)
out <- list(
tags$h2(
id = paste0("dg-", tolower(pos)),
style = pos_header_style,
position_labels[[pos]]
)
)
for (grp in tier_groups(pos_players)) {
out <- c(out, list(tags$h3(style = tier_header_style, grp$label)))
for (i in seq_len(nrow(grp$players))) {
row <- grp$players[i, ]
heading_text <- paste0(
row$pos_rank,
". ",
row$name,
", ",
row$full_team
)
heading <- if (is_blank(row$player_profile_url)) {
tags$h4(style = player_header_style, heading_text)
} else {
tags$h4(
style = player_header_style,
tags$a(href = row$player_profile_url, heading_text)
)
}
out <- c(
out,
list(heading),
lapply(
player_paragraphs(row),
function(txt) tags$p(style = p_style, txt)
)
)
}
}
tagList(out)
}
static_doc <- tags$html(
tags$head(
tags$meta(charset = "UTF-8"),
tags$meta(
name = "viewport",
content = "width=device-width, initial-scale=1"
),
tags$title(article_title)
),
tags$body(
intro_section,
lapply(positions_present, render_position_static)
)
)
league_slug <- gsub("\\s+", "_", tolower(league_type))
static_basename <- paste("draft_guide_doc", league_slug, ".html", sep = "_")
interactive_basename <- paste("draft_guide_html", league_slug, ".html", sep = "_")
for (dir in output_dirs) {
save_html(static_doc, file.path(dir, static_basename))
}
# ---------------------------------------------------------------------------
# Interactive version - self-contained, responsive, for iframe embed
# ---------------------------------------------------------------------------
nav_html <- paste(
vapply(
positions_present,
function(pos) {
sprintf(
'        <button type="button" class="dg-pill" data-pos="%s">%s</button>',
esc(pos),
esc(pos)
)
},
character(1)
),
collapse = "\n"
)
render_position_interactive <- function(pos) {
pos_players <- players %>% filter(position == pos)
lines <- c(
sprintf(
'    <section class="dg-section" id="dg-pos-%s" data-pos="%s">',
esc(tolower(pos)),
esc(pos)
),
sprintf('      <h2 class="dg-pos-title">%s</h2>', esc(position_labels[[pos]]))
)
for (grp in tier_groups(pos_players)) {
tier_players <- grp$players
tier_label <- grp$label
lines <- c(
lines,
'      <div class="dg-tier">',
sprintf(
paste0(
'        <button type="button" class="dg-tier-toggle" ',
'aria-expanded="true"><span class="dg-tier-name">%s</span>',
'<span class="dg-tier-meta">%d %s</span>',
'<span class="dg-chevron" aria-hidden="true"></span></button>'
),
esc(tier_label),
nrow(tier_players),
if (nrow(tier_players) == 1) "player" else "players"
),
'        <div class="dg-tier-body">'
)
for (i in seq_len(nrow(tier_players))) {
row <- tier_players[i, ]
name_html <- if (is_blank(row$player_profile_url)) {
esc(row$name)
} else {
sprintf(
'<a href="%s" target="_blank" rel="noopener noreferrer">%s</a>',
esc(row$player_profile_url),
esc(row$name)
)
}
lines <- c(
lines,
sprintf(
'          <article class="dg-player" id="dg-player-%s" data-search="%s">',
esc(slugify(paste(row$name, pos))),
esc(tolower(paste(row$name, row$full_team, pos)))
),
'            <h3 class="dg-player-head">',
sprintf('              <span class="dg-rank">%s</span>', esc(row$pos_rank)),
sprintf('              <span class="dg-name">%s</span>', name_html),
sprintf('              <span class="dg-team">%s</span>', esc(row$full_team)),
'            </h3>',
paste0(
'            <div class="dg-body">',
paste(
vapply(
player_paragraphs(row),
function(txt) sprintf("<p>%s</p>", esc(txt)),
character(1)
),
collapse = ""
),
"</div>"
),
"          </article>"
)
}
lines <- c(lines, "        </div>", "      </div>")
}
c(lines, "    </section>")
}
intro_bullets_html <- if (length(bullets) == 0) {
character(0)
} else {
c(
'      <ul class="dg-bullets">',
vapply(
bullets,
function(b) {
sprintf(
"        <li><strong>%s</strong> %s</li>",
esc(b$prefix),
esc(b$body)
)
},
character(1)
),
"      </ul>"
)
}
intro_paras_html <- {
intro_paras <- c(intro_text, intro_text_two, intro_text_three)
intro_paras <- intro_paras[!is_blank(intro_paras)]
vapply(
intro_paras,
function(txt) sprintf('      <p class="dg-intro-p">%s</p>', esc(txt)),
character(1)
)
}
html_lines <- c(
"<!DOCTYPE html>",
'<html lang="en">',
"<head>",
'  <meta charset="UTF-8">',
'  <meta name="viewport" content="width=device-width, initial-scale=1">',
sprintf("  <title>%s</title>", esc(article_title)),
'  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&display=swap" rel="stylesheet">',
"  <style>",
"    #pff-draft-guide {",
"      font-family: 'Archivo', Arial, sans-serif;",
"      color: #1a1a1a;",
"      max-width: 900px;",
"      margin: 0 auto;",
"      padding: 0 12px 48px;",
"      line-height: 1.55;",
"      -webkit-text-size-adjust: 100%;",
"    }",
"    #pff-draft-guide * { box-sizing: border-box; }",
"    #pff-draft-guide a { color: #0d6efd; text-decoration: none; }",
"    #pff-draft-guide a:hover { text-decoration: underline; }",
"    #pff-draft-guide .dg-bullets { margin: 0 0 1em; padding-left: 1.1em; font-size: 1rem; }",
"    #pff-draft-guide .dg-bullets li { margin-bottom: 0.4em; }",
"    #pff-draft-guide .dg-intro-p { margin: 0 0 1em; font-size: 1rem; }",
"    #pff-draft-guide .dg-meta { font-size: 0.875rem; color: #666; margin: 0 0 1em; }",
"",
"    #pff-draft-guide .dg-nav {",
"      position: sticky;",
"      top: 0;",
"      z-index: 20;",
"      background: #fff;",
"      border-bottom: 1px solid #e3e3e3;",
"      padding: 8px 0;",
"      margin-bottom: 8px;",
"    }",
"    #pff-draft-guide .dg-pills { display: flex; gap: 6px; flex-wrap: wrap; }",
"    #pff-draft-guide .dg-pill {",
"      flex: 1 1 auto;",
"      min-width: 56px;",
"      font: inherit;",
"      font-weight: 600;",
"      font-size: 0.875rem;",
"      padding: 7px 14px;",
"      border: 1px solid #ccc;",
"      border-radius: 999px;",
"      background: #f6f7f8;",
"      color: #1a1a1a;",
"      cursor: pointer;",
"    }",
"    #pff-draft-guide .dg-pill:hover { background: #e9ecef; }",
"    #pff-draft-guide .dg-pill.is-active { background: #1a1a1a; border-color: #1a1a1a; color: #fff; }",
"    #pff-draft-guide .dg-search {",
"      width: 100%;",
"      margin-top: 6px;",
"      padding: 8px 12px;",
"      font: inherit;",
"      font-size: 0.9375rem;",
"      border: 1px solid #ccc;",
"      border-radius: 6px;",
"    }",
"    #pff-draft-guide .dg-noresults { display: none; padding: 24px 4px; color: #666; }",
"    #pff-draft-guide.is-empty .dg-noresults { display: block; }",
"",
"    #pff-draft-guide .dg-pos-title {",
"      font-size: 1.5rem;",
"      font-weight: 700;",
"      margin: 1.5em 0 0.5em;",
"      padding-bottom: 6px;",
"      border-bottom: 2px solid #1a1a1a;",
"      scroll-margin-top: 120px;",
"    }",
"    #pff-draft-guide .dg-section { scroll-margin-top: 120px; }",
"    #pff-draft-guide .dg-tier { border-bottom: 1px solid #eee; }",
"    #pff-draft-guide .dg-tier-toggle {",
"      display: flex;",
"      align-items: center;",
"      gap: 8px;",
"      width: 100%;",
"      font: inherit;",
"      font-weight: 700;",
"      font-size: 1.0625rem;",
"      text-align: left;",
"      padding: 12px 4px;",
"      background: none;",
"      border: 0;",
"      color: inherit;",
"      cursor: pointer;",
"    }",
"    #pff-draft-guide .dg-tier-name { flex: 0 0 auto; }",
"    #pff-draft-guide .dg-tier-meta { flex: 1 1 auto; font-weight: 400; font-size: 0.8125rem; color: #777; }",
"    #pff-draft-guide .dg-chevron {",
"      flex: 0 0 auto;",
"      width: 9px;",
"      height: 9px;",
"      border-right: 2px solid #555;",
"      border-bottom: 2px solid #555;",
"      transform: rotate(45deg);",
"      transition: transform 0.15s ease;",
"    }",
'    #pff-draft-guide .dg-tier-toggle[aria-expanded="false"] .dg-chevron { transform: rotate(-45deg); }',
'    #pff-draft-guide .dg-tier-toggle[aria-expanded="false"] + .dg-tier-body { display: none; }',
"    #pff-draft-guide .dg-tier-body { padding-bottom: 8px; }",
"",
"    #pff-draft-guide .dg-player { padding: 10px 0 14px; scroll-margin-top: 120px; }",
"    #pff-draft-guide .dg-player + .dg-player { border-top: 1px solid #f0f0f0; }",
"    #pff-draft-guide .dg-player-head {",
"      display: flex;",
"      align-items: baseline;",
"      flex-wrap: wrap;",
"      gap: 4px 8px;",
"      font-size: 1.125rem;",
"      font-weight: 700;",
"      margin: 0 0 0.5em;",
"    }",
"    #pff-draft-guide .dg-rank {",
"      flex: 0 0 auto;",
"      min-width: 30px;",
"      font-size: 0.8125rem;",
"      font-weight: 700;",
"      color: #fff;",
"      background: #555;",
"      border-radius: 4px;",
"      padding: 2px 7px;",
"      text-align: center;",
"    }",
"    #pff-draft-guide .dg-team { font-size: 0.875rem; font-weight: 400; color: #666; }",
"    #pff-draft-guide .dg-body p { margin: 0 0 0.85em; font-size: 1rem; }",
"    #pff-draft-guide .dg-body p:last-child { margin-bottom: 0; }",
"    #pff-draft-guide .dg-hidden { display: none !important; }",
"",
"    @media (max-width: 576px) {",
"      #pff-draft-guide { padding: 0 4px 32px; line-height: 1.5; }",
"      #pff-draft-guide .dg-pill { padding: 8px 10px; font-size: 0.9375rem; min-width: 0; }",
"      #pff-draft-guide .dg-pos-title { font-size: 1.3125rem; }",
"      #pff-draft-guide .dg-player-head { font-size: 1.0625rem; }",
"      #pff-draft-guide .dg-body p { font-size: 0.9375rem; }",
"      #pff-draft-guide .dg-section, #pff-draft-guide .dg-pos-title, #pff-draft-guide .dg-player { scroll-margin-top: 104px; }",
"    }",
"",
"    @media (prefers-color-scheme: dark) {",
"      #pff-draft-guide { color: #e8e8e8; }",
"      #pff-draft-guide .dg-nav { background: #17181a; border-bottom-color: #333; }",
"      #pff-draft-guide .dg-pill { background: #232427; border-color: #3a3b3f; color: #e8e8e8; }",
"      #pff-draft-guide .dg-pill.is-active { background: #e8e8e8; border-color: #e8e8e8; color: #17181a; }",
"      #pff-draft-guide .dg-search { background: #232427; border-color: #3a3b3f; color: #e8e8e8; }",
"      #pff-draft-guide .dg-pos-title { border-bottom-color: #e8e8e8; }",
"      #pff-draft-guide .dg-tier { border-bottom-color: #2c2d30; }",
"      #pff-draft-guide .dg-player + .dg-player { border-top-color: #232427; }",
"      #pff-draft-guide .dg-chevron { border-color: #aaa; }",
"      #pff-draft-guide a { color: #6ea8fe; }",
"    }",
"",
"    @media print {",
"      #pff-draft-guide .dg-nav { display: none !important; }",
'      #pff-draft-guide .dg-tier-toggle[aria-expanded="false"] + .dg-tier-body { display: block !important; }',
"      #pff-draft-guide a { color: #000; text-decoration: none; }",
"    }",
"  </style>",
"</head>",
"<body>",
'  <div id="pff-draft-guide">',
'    <div class="dg-intro">',
intro_bullets_html,
intro_paras_html,
if (nzchar(last_updated)) {
sprintf('      <p class="dg-meta"><strong>%s</strong></p>', esc(last_updated))
} else {
character(0)
},
"    </div>",
'    <nav class="dg-nav">',
'      <div class="dg-pills">',
nav_html,
"      </div>",
sprintf(
'      <input type="search" class="dg-search" placeholder="Search %d players by name or team" aria-label="Search players">',
nrow(players)
),
"    </nav>",
'    <p class="dg-noresults">No players match that search.</p>',
unlist(lapply(positions_present, render_position_interactive)),
"  </div>",
"  <script>",
"  (function () {",
'    var root = document.getElementById("pff-draft-guide");',
"    if (!root) return;",
'    var pills = Array.prototype.slice.call(root.querySelectorAll(".dg-pill"));',
'    var sections = Array.prototype.slice.call(root.querySelectorAll(".dg-section"));',
'    var players = Array.prototype.slice.call(root.querySelectorAll(".dg-player"));',
'    var search = root.querySelector(".dg-search");',
"",
"    function setActive(pos) {",
"      pills.forEach(function (p) {",
'        p.classList.toggle("is-active", p.dataset.pos === pos);',
"      });",
"    }",
"",
"    pills.forEach(function (pill) {",
'      pill.addEventListener("click", function () {',
'        var target = root.querySelector(\'.dg-section[data-pos="\' + pill.dataset.pos + \'"]\');',
"        if (!target) return;",
"        setActive(pill.dataset.pos);",
"        // Hold off the scrollspy while the smooth scroll passes over the",
"        // sections in between, otherwise it overwrites the clicked pill.",
"        scrollLockUntil = Date.now() + 1000;",
'        target.scrollIntoView({ behavior: "smooth", block: "start" });',
"      });",
"    });",
"",
'    root.addEventListener("click", function (e) {',
'      var btn = e.target.closest(".dg-tier-toggle");',
"      if (!btn || !root.contains(btn)) return;",
'      btn.setAttribute("aria-expanded", btn.getAttribute("aria-expanded") === "true" ? "false" : "true");',
"    });",
"",
"    if (search) {",
"      var timer = null;",
'      search.addEventListener("input", function () {',
"        clearTimeout(timer);",
"        timer = setTimeout(function () {",
"          var q = search.value.trim().toLowerCase();",
"          var anyVisible = false;",
"",
"          players.forEach(function (el) {",
'            var hit = !q || (el.dataset.search || "").indexOf(q) !== -1;',
'            el.classList.toggle("dg-hidden", !hit);',
"            if (hit) anyVisible = true;",
"          });",
"",
'          Array.prototype.forEach.call(root.querySelectorAll(".dg-tier"), function (tier) {',
'            var visible = tier.querySelectorAll(".dg-player:not(.dg-hidden)").length;',
'            tier.classList.toggle("dg-hidden", visible === 0);',
'            var toggle = tier.querySelector(".dg-tier-toggle");',
'            if (q && toggle) toggle.setAttribute("aria-expanded", "true");',
"          });",
"",
"          sections.forEach(function (section) {",
'            var visible = section.querySelectorAll(".dg-player:not(.dg-hidden)").length;',
'            section.classList.toggle("dg-hidden", visible === 0);',
"          });",
"",
'          root.classList.toggle("is-empty", !anyVisible);',
"        }, 120);",
"      });",
"    }",
"",
"    // Scrollspy. Deliberately not an IntersectionObserver: several sections",
"    // are on screen at once, so IO highlights whichever entry happens to fire",
"    // last, and it never reaches the last section once the page bottoms out.",
"    var scrollLockUntil = 0;",
"    var ticking = false;",
"",
"    function currentSection() {",
"      var visible = sections.filter(function (s) {",
'        return !s.classList.contains("dg-hidden");',
"      });",
"      if (!visible.length) return null;",
"      var doc = document.documentElement;",
"      if (window.innerHeight + window.pageYOffset >= doc.scrollHeight - 2) {",
"        return visible[visible.length - 1];",
"      }",
"      var line = 130;",
"      var active = visible[0];",
"      visible.forEach(function (s) {",
"        if (s.getBoundingClientRect().top <= line) active = s;",
"      });",
"      return active;",
"    }",
"",
"    function syncActive() {",
"      if (Date.now() < scrollLockUntil) return;",
"      var s = currentSection();",
"      if (s) setActive(s.dataset.pos);",
"    }",
"",
'    window.addEventListener("scroll", function () {',
"      if (ticking) return;",
"      ticking = true;",
"      window.requestAnimationFrame(function () {",
"        ticking = false;",
"        syncActive();",
"      });",
"    }, { passive: true });",
"",
"    syncActive();",
"    if (!root.querySelector(\".dg-pill.is-active\") && pills.length) {",
"      setActive(pills[0].dataset.pos);",
"    }",
"  })();",
"  </script>",
"</body>",
"</html>"
)
for (dir in output_dirs) {
writeLines(html_lines, file.path(dir, interactive_basename))
}
message(
"Wrote ", static_basename, " and ", interactive_basename, " to:\n  ",
paste(output_dirs, collapse = "\n  ")
)
setwd(git_dir)
if (push_to_git) {
gert::git_add(".")
# Re-running without changing the sheets regenerates a byte-identical file,
# which stages nothing and makes git_commit() error out. Only commit when
# there is actually something staged, but still push in case an earlier
# commit was made and the push didn't go through.
if (nrow(gert::git_status(staged = TRUE)) > 0) {
gert::git_commit("Update draft guide HTML")
} else {
message("html_tests: embed file unchanged, nothing new to commit.")
}
gert::git_push(remote = "origin")
}
