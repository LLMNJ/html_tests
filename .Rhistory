n <- min(length(cells), length(headers))
txt <- map_chr(cells[seq_len(n)], cell_text)
hrefs <- map_chr(cells[seq_len(n)], cell_href)
names(txt) <- headers[seq_len(n)]
names(hrefs) <- paste0(headers[seq_len(n)], "_url")
as_tibble(as.list(c(txt, hrefs)))
}
map(rows, parse_row) |> list_rbind()
}
# Find the "Next Page" link, if there is one.
next_page_url <- function(page) {
nxt <- html_element(page, "a[title='Next Page']")
if (inherits(nxt, "xml_missing")) {
links <- html_elements(page, "a")
hit <- which(str_squish(html_text2(links)) == "Next Page")
if (length(hit) == 0) return(NA_character_)
nxt <- links[[hit[1]]]
}
href <- html_attr(nxt, "href")
if (is.na(href)) return(NA_character_)
url_absolute(href, "https://www.nfl.com")
}
# --- one category, one month (follows pagination) ---------------------------
pull_category_month <- function(
category,
year,
month,
delay = 1.5,
max_pages = 200,
verbose = TRUE
) {
url <- sprintf(
"https://www.nfl.com/transactions/league/%s/%d/%d",
category,
as.integer(year),
as.integer(month)
)
out <- list()
seen <- character(0)
page_num <- 0
while (!is.na(url) && page_num < max_pages) {
if (url %in% seen) break # guard against a self-referencing next link
seen <- c(seen, url)
page <- fetch_page(url)
if (is.null(page)) break
rows <- parse_transactions_table(page)
page_num <- page_num + 1
if (nrow(rows) > 0) out[[length(out) + 1]] <- rows
if (verbose) {
message(sprintf(
"  %s %d-%02d page %d: %d rows",
category,
year,
month,
page_num,
nrow(rows)
))
}
url <- next_page_url(page)
if (!is.na(url)) Sys.sleep(delay)
}
if (page_num >= max_pages) {
warning(
"Hit max_pages for ",
category,
" ",
year,
"-",
month,
call. = FALSE
)
}
res <- list_rbind(out)
if (nrow(res) == 0) return(tibble())
# Drop link columns that never carried a link (date_url, transaction_url, ...)
res <- res |> select(where(~ !all(is.na(.x))))
# Real dates: page shows MM/DD, year comes from the URL
if ("date" %in% names(res)) {
res <- res |>
mutate(
date = suppressWarnings(
as.Date(paste0(year, "/", date), format = "%Y/%m/%d")
)
)
}
if ("name_url" %in% names(res))
res <- res |> mutate(player_slug = url_slug(name_url))
if ("to_url" %in% names(res)) res <- res |> mutate(to_slug = url_slug(to_url))
if ("from_url" %in% names(res))
res <- res |> mutate(from_slug = url_slug(from_url))
res |>
mutate(
category = category,
year = as.integer(year),
month = as.integer(month),
scraped_at = Sys.time()
)
}
# --- one month, all six categories ------------------------------------------
pull_month <- function(
year,
month,
categories = NFL_TX_CATEGORIES,
delay = 1.5,
verbose = TRUE
) {
map(categories, function(cat) {
res <- pull_category_month(
cat,
year,
month,
delay = delay,
verbose = verbose
)
Sys.sleep(delay)
res
}) |>
list_rbind()
}
# --- full-history backfill (resumable) --------------------------------------
backfill_nfl_transactions <- function(
years = 1965:2026,
months = 1:12,
categories = NFL_TX_CATEGORIES,
cache_dir = "nfl_tx_cache",
delay = 1.5,
verbose = TRUE
) {
dir.create(cache_dir, showWarnings = FALSE, recursive = TRUE)
grid <- expand.grid(
year = years,
month = months,
category = categories,
stringsAsFactors = FALSE
) |>
arrange(desc(year), desc(month), category)
for (i in seq_len(nrow(grid))) {
yr <- grid$year[i]
mo <- grid$month[i]
cat <- grid$category[i]
f <- file.path(cache_dir, sprintf("%d-%02d_%s.rds", yr, mo, cat))
# Already have it: skip. This is what makes the run resumable.
if (file.exists(f)) next
# Don't request months that haven't happened yet
if (as.Date(sprintf("%d-%02d-01", yr, mo)) > Sys.Date()) next
if (verbose)
message(sprintf("[%d/%d] %d-%02d %s", i, nrow(grid), yr, mo, cat))
res <- pull_category_month(cat, yr, mo, delay = delay, verbose = verbose)
# Write even when empty, so empty months aren't re-fetched on the next run
saveRDS(res, f)
Sys.sleep(delay)
}
invisible(TRUE)
}
# Combine every cached file into one tibble
load_nfl_tx_cache <- function(cache_dir = "nfl_tx_cache") {
files <- list.files(cache_dir, pattern = "\\.rds$", full.names = TRUE)
map(files, readRDS) |>
list_rbind() |>
arrange(desc(date))
}
# --- usage ------------------------------------------------------------------
# Test on one month first before turning it loose on 60 years:
# sept <- pull_month(2026, 9)
# Full backfill (hours - safe to interrupt and rerun):
# backfill_nfl_transactions()
# Or work through it in chunks:
# backfill_nfl_transactions(years = 2020:2026)
# backfill_nfl_transactions(years = 2010:2019)
# Then load everything:
# all_tx <- load_nfl_tx_cache()
# Ongoing use, one month at a time:
# oct <- pull_month(2026, 10)
test <- pull_month(2026, 9)
View(test)
# NFL.com transactions scraper
#
# Two uses:
#   1. backfill_nfl_transactions()  - pull the full 1965-present history (resumable)
#   2. pull_month(year, month)      - pull one specific month on demand
#
# Pages look like:
#   https://www.nfl.com/transactions/league/<category>/<year>/<month>
# and paginate via a "Next Page" link carrying an ?after= token.
library(rvest)
library(httr2)
library(dplyr)
library(purrr)
library(stringr)
library(tibble)
NFL_TX_CATEGORIES <- c(
"signings",
"trades",
"reserve-list",
"waivers",
"terminations",
"other"
)
NFL_TX_UA <- "test"
# --- low-level helpers ------------------------------------------------------
dedupe_repeat <- function(x) {
inner <- str_match(x, "^(.+?)\\s+\\1$")[, 2]
ifelse(is.na(inner), x, inner)
}
cell_text <- function(cell) {
str_squish(html_text2(cell)) |> dedupe_repeat()
}
cell_href <- function(cell) {
a <- html_element(cell, "a")
if (inherits(a, "xml_missing")) return(NA_character_)
href <- html_attr(a, "href")
if (is.na(href)) return(NA_character_)
url_absolute(href, "https://www.nfl.com")
}
url_slug <- function(x) {
str_remove(x, "/+$") |> str_extract("[^/]+$")
}
# Fetch a URL politely. Returns an xml_document, or NULL on 404 / hard failure.
fetch_page <- function(url, timeout = 30) {
resp <- tryCatch(
request(url) |>
req_user_agent(NFL_TX_UA) |>
req_timeout(timeout) |>
req_retry(max_tries = 3, backoff = ~ 2^.x) |>
req_error(is_error = function(resp) FALSE) |>
req_perform(),
error = function(e) {
warning(
"Request failed: ",
url,
" (",
conditionMessage(e),
")",
call. = FALSE
)
NULL
}
)
if (is.null(resp)) return(NULL)
if (resp_status(resp) != 200) {
if (resp_status(resp) != 404) {
warning("HTTP ", resp_status(resp), ": ", url, call. = FALSE)
}
return(NULL)
}
read_html(resp_body_string(resp))
}
# --- parsing ----------------------------------------------------------------
parse_transactions_table <- function(page) {
tbl <- html_element(page, "table")
if (inherits(tbl, "xml_missing")) return(tibble())
headers <- tbl |>
html_elements("thead th") |>
html_text2() |>
str_squish() |>
tolower() |>
str_replace_all("[^a-z0-9]+", "_") |>
str_remove_all("^_|_$")
if (length(headers) == 0) return(tibble())
rows <- html_elements(tbl, "tbody tr")
parse_row <- function(row) {
cells <- html_elements(row, "td, th")
if (length(cells) == 0) return(NULL)
n <- min(length(cells), length(headers))
txt <- map_chr(cells[seq_len(n)], cell_text)
hrefs <- map_chr(cells[seq_len(n)], cell_href)
names(txt) <- headers[seq_len(n)]
names(hrefs) <- paste0(headers[seq_len(n)], "_url")
as_tibble(as.list(c(txt, hrefs)))
}
map(rows, parse_row) |> list_rbind()
}
# Find the "Next Page" link, if there is one.
next_page_url <- function(page) {
nxt <- html_element(page, "a[title='Next Page']")
if (inherits(nxt, "xml_missing")) {
links <- html_elements(page, "a")
hit <- which(str_squish(html_text2(links)) == "Next Page")
if (length(hit) == 0) return(NA_character_)
nxt <- links[[hit[1]]]
}
href <- html_attr(nxt, "href")
if (is.na(href)) return(NA_character_)
url_absolute(href, "https://www.nfl.com")
}
# --- one category, one month (follows pagination) ---------------------------
#
# NFL.com's pagination is unreliable. Following "Next Page" sometimes jumps
# backward to the top of the list, which is why clicking next in the browser
# can look like it did nothing. It does move forward if you keep going, so we
# ignore the URL as a progress signal and track which ROWS we've already seen.
#
# Two kinds of no-progress page:
#   bounce - all rows already seen, but they're NEWER than our oldest row.
#            The cursor jumped backward. Keep going, don't count it.
#   stall  - all rows already seen, at or older than our oldest row.
#            Probably genuinely the end. Count it; bail after max_stall.
row_keys <- function(df) {
df <- df |> select(-any_of(c("scraped_at", "category", "year", "month")))
do.call(paste, c(as.list(df), sep = "|"))
}
pull_category_month <- function(
category,
year,
month,
delay = 1.5,
max_pages = 400,
max_stall = 6,
verbose = TRUE
) {
base_url <- sprintf(
"https://www.nfl.com/transactions/league/%s/%d/%d",
category,
as.integer(year),
as.integer(month)
)
url <- base_url
out <- list()
seen_keys <- character(0)
min_day <- Inf # oldest day-of-month collected so far
stall <- 0
bounces <- 0
page_num <- 0
while (!is.na(url) && page_num < max_pages && stall <= max_stall) {
page <- fetch_page(url)
page_num <- page_num + 1
if (is.null(page)) {
stall <- stall + 1
Sys.sleep(delay * 2)
next # retry the same URL
}
rows <- parse_transactions_table(page)
if (nrow(rows) == 0) {
stall <- stall + 1
} else {
keys <- row_keys(rows)
is_new <- !keys %in% seen_keys
# day-of-month for this page, used to tell a bounce from a real ending
page_day <- suppressWarnings(
min(as.integer(str_extract(rows$date, "(?<=/)\\d{2}$")), na.rm = TRUE)
)
if (any(is_new)) {
out[[length(out) + 1]] <- rows[is_new, , drop = FALSE]
seen_keys <- c(seen_keys, keys[is_new])
stall <- 0
if (is.finite(page_day)) min_day <- min(min_day, page_day)
} else if (
is.finite(page_day) && is.finite(min_day) && page_day > min_day
) {
bounces <- bounces + 1 # jumped backward; keep crawling
} else {
stall <- stall + 1
}
if (verbose) {
message(sprintf(
"  %s %d-%02d page %d: %d rows (%d new, stall %d)",
category,
year,
month,
page_num,
nrow(rows),
sum(is_new),
stall
))
}
}
url <- next_page_url(page)
if (!is.na(url)) Sys.sleep(delay)
}
if (page_num >= max_pages) {
warning(
"Hit max_pages for ",
category,
" ",
year,
"-",
month,
" - may be incomplete",
call. = FALSE
)
}
if (verbose && bounces > 0) {
message(sprintf("  (%d backward jumps absorbed)", bounces))
}
res <- list_rbind(out)
if (nrow(res) == 0) return(tibble())
# Drop link columns that never carried a link (date_url, transaction_url, ...)
res <- res |> select(where(~ !all(is.na(.x))))
# Real dates: page shows MM/DD, year comes from the URL
if ("date" %in% names(res)) {
res <- res |>
mutate(
date = suppressWarnings(
as.Date(paste0(year, "/", date), format = "%Y/%m/%d")
)
)
}
if ("name_url" %in% names(res))
res <- res |> mutate(player_slug = url_slug(name_url))
if ("to_url" %in% names(res)) res <- res |> mutate(to_slug = url_slug(to_url))
if ("from_url" %in% names(res))
res <- res |> mutate(from_slug = url_slug(from_url))
res |>
mutate(
category = category,
year = as.integer(year),
month = as.integer(month),
scraped_at = Sys.time()
)
}
# --- one month, all six categories ------------------------------------------
pull_month <- function(
year,
month,
categories = NFL_TX_CATEGORIES,
delay = 1.5,
verbose = TRUE
) {
map(categories, function(cat) {
res <- pull_category_month(
cat,
year,
month,
delay = delay,
verbose = verbose
)
Sys.sleep(delay)
res
}) |>
list_rbind()
}
# --- full-history backfill (resumable) --------------------------------------
backfill_nfl_transactions <- function(
years = 1965:2026,
months = 1:12,
categories = NFL_TX_CATEGORIES,
cache_dir = "nfl_tx_cache",
delay = 1.5,
verbose = TRUE
) {
dir.create(cache_dir, showWarnings = FALSE, recursive = TRUE)
grid <- expand.grid(
year = years,
month = months,
category = categories,
stringsAsFactors = FALSE
) |>
arrange(desc(year), desc(month), category)
for (i in seq_len(nrow(grid))) {
yr <- grid$year[i]
mo <- grid$month[i]
cat <- grid$category[i]
f <- file.path(cache_dir, sprintf("%d-%02d_%s.rds", yr, mo, cat))
# Already have it: skip. This is what makes the run resumable.
if (file.exists(f)) next
# Don't request months that haven't happened yet
if (as.Date(sprintf("%d-%02d-01", yr, mo)) > Sys.Date()) next
if (verbose)
message(sprintf("[%d/%d] %d-%02d %s", i, nrow(grid), yr, mo, cat))
res <- pull_category_month(cat, yr, mo, delay = delay, verbose = verbose)
# Write even when empty, so empty months aren't re-fetched on the next run
saveRDS(res, f)
Sys.sleep(delay)
}
invisible(TRUE)
}
# Combine every cached file into one tibble
load_nfl_tx_cache <- function(cache_dir = "nfl_tx_cache") {
files <- list.files(cache_dir, pattern = "\\.rds$", full.names = TRUE)
map(files, readRDS) |>
list_rbind() |>
arrange(desc(date))
}
# --- completeness check -----------------------------------------------------
#
# Given the pagination flakiness, verify rather than assume. This shows how many
# rows landed on each day of the month. A day with zero rows in the middle of a
# busy stretch is a red flag worth re-pulling.
check_month_coverage <- function(df) {
df |>
filter(!is.na(date)) |>
count(category, date, name = "rows") |>
arrange(category, date)
}
# Re-pull a month and compare row counts against what you already have.
# Same answer twice is decent evidence the crawl is complete.
verify_month <- function(year, month, existing, delay = 1.5) {
fresh <- pull_month(year, month, delay = delay, verbose = FALSE)
left_join(
existing |> count(category, name = "first_pull"),
fresh |> count(category, name = "second_pull"),
by = "category"
) |>
mutate(match = first_pull == second_pull)
}
# --- usage ------------------------------------------------------------------
# Test on one month first before turning it loose on 60 years:
# sept <- pull_month(2026, 9)
# Full backfill (hours - safe to interrupt and rerun):
# backfill_nfl_transactions()
# Or work through it in chunks:
# backfill_nfl_transactions(years = 2020:2026)
# backfill_nfl_transactions(years = 2010:2019)
# Then load everything:
# all_tx <- load_nfl_tx_cache()
# Ongoing use, one month at a time:
# oct <- pull_month(2026, 10)
sept <- pull_month(2026, 9)
count(sept, category)
check_month_coverage(sept)
table(test$date)
table(sept$date)
