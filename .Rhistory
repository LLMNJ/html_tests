overall_rank = if_else(
position %in% c('QB', 'RB', 'WR', 'TE'),
as.character(cumsum(position %in% c('QB', 'RB', 'WR', 'TE'))),
""
)
) %>%
rename(position_rank = w_ppr_rank) %>%
select(
overall_rank,
position_rank,
position,
name,
team,
everything(),
-week_ppr_proj
)
week_half <- players %>%
filter(
(players$position == 'QB' & week_rank <= number_games * 2) |
(players$position == 'RB' & week_rank <= rb_players) |
(players$position == 'WR' & week_rank <= wr_players) |
(players$position == 'TE' & week_rank <= te_players)
) %>%
select(pff_id, position, name, team, week_rank) %>%
mutate(week_id = current_week_input) %>%
inner_join(shares_week_half, by = c("position", "week_rank")) %>%
arrange(desc(week_half_proj)) %>%
select(-week_rank, -week_half_proj)
week_standard <- players %>%
filter(
(players$position == 'QB' & w_standard_rank <= number_games * 2) |
(players$position == 'RB' & w_standard_rank <= rb_players) |
(players$position == 'WR' & w_standard_rank <= wr_players) |
(players$position == 'TE' & w_standard_rank <= te_players)
) %>%
select(pff_id, position, name, team, w_standard_rank) %>%
mutate(week_id = current_week_input) %>%
inner_join(shares_week_standard, by = c("position", "w_standard_rank")) %>%
arrange(desc(week_standard_proj)) %>%
select(-w_standard_rank, -week_standard_proj)
week_k <- players %>%
filter(players$position == 'K') %>%
select(pff_id, position, name, team, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
slice_head(n = number_games * 2) %>%
select(-week_rank)
week_def <- players %>%
filter(players$position == 'DEF') %>%
select(pff_id, position, name, team, week_rank) %>%
mutate(
week_id = current_week_input,
pff_id = sub("^pff-team-", "", as.character(pff_id))
) %>%
arrange(week_rank) %>%
slice_head(n = number_games * 2) %>%
select(-week_rank)
week_idp <- idp_players %>%
arrange(week_rank) %>%
slice_head(n = 360)
week_dl <- week_idp %>%
filter(week_idp$pff_position %in% c('DI', 'ED')) %>%
mutate(position = pff_position) %>%
select(pff_id, name, team, position, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
select(-week_rank)
week_lb <- week_idp %>%
filter(week_idp$pff_position %in% c('LB')) %>%
mutate(position = pff_position) %>%
select(pff_id, name, team, position, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
select(-week_rank)
week_db <- week_idp %>%
filter(week_idp$pff_position %in% c('CB', 'S')) %>%
mutate(position = pff_position) %>%
select(pff_id, name, team, position, week_rank) %>%
mutate(week_id = current_week_input) %>%
arrange(week_rank) %>%
select(-week_rank)
idp_article <- week_idp %>%
mutate(position = pff_position) %>%
select(
pff_position,
idp_position,
name,
team,
week_rank,
opponent,
start_time_est,
home_away,
injury,
injury_status,
pff_player_url,
team_url,
opponent_url
) %>%
rename(overall_rank = week_rank) %>%
select(
overall_rank,
pff_position,
idp_position,
name,
team,
everything()
)
creds <- jsonlite::fromJSON(
txt = glue::glue("/home/nathan/aws_creds_consumer.json")
)
Sys.setenv("AWS_ACCESS_KEY_ID" = creds$AccessKeyId)
Sys.setenv("AWS_SECRET_ACCESS_KEY" = creds$SecretAccessKey)
Sys.setenv("AWS_SESSION_TOKEN" = creds$SessionToken)
Sys.setenv("AWS_DEFAULT_REGION" = "us-east-2")
#This is for draft rankings
names(players)[names(players) == "pff_id"] <- "PFF_ID"
names(players)[names(players) == "team"] <- "TEAM"
names(players)[names(players) == "name"] <- "NAME"
names(idp_players)[names(idp_players) == "pff_id"] <- "PFF_ID"
names(idp_players)[names(idp_players) == "team"] <- "TEAM"
names(idp_players)[names(idp_players) == "name"] <- "NAME"
tiers <- players %>%
group_by(position, pos_tier) %>%
summarise(count = n())
tiers <- tiers %>%
arrange(position, pos_tier) %>%
group_by(position) %>%
mutate(cum_count = cumsum(count))
idp_tiers <- idp_players %>%
group_by(idp_position, pos_tier) %>%
summarise(count = n())
idp_tiers <- idp_tiers %>%
arrange(idp_position, pos_tier) %>%
group_by(idp_position) %>%
mutate(cum_count = cumsum(count))
ppr <- select(players, PFF_ID, NAME, TEAM, ppr_rank, position)
ros_ppr <- select(ppr, PFF_ID, NAME, TEAM, ppr_rank, position)
ppr <- process_table(ppr, tiers, max_rank = 512)
half <- select(players, PFF_ID, NAME, TEAM, half_rank, position)
ros_half <- select(half, PFF_ID, NAME, TEAM, half_rank, position)
half <- process_table(half, tiers, max_rank = 512)
non <- select(players, PFF_ID, NAME, TEAM, standard_rank, position)
ros_non <- select(non, PFF_ID, NAME, TEAM, standard_rank, position)
non <- process_table(non, tiers, max_rank = 512)
super <- select(players, PFF_ID, NAME, TEAM, superflex_rank, position)
super <- process_table(super, tiers, max_rank = 512)
idp <- select(idp_players, PFF_ID, NAME, TEAM, rank, idp_position)
idp <- process_table(
idp,
idp_tiers,
position_col = "idp_position",
max_rank = 350
)
dyn <- select(players, PFF_ID, NAME, TEAM, dynasty_rank, position)
dyn <- process_table(dyn, tiers, max_rank = 300)
dyn_half <- select(players, PFF_ID, NAME, TEAM, dynasty_half_rank, position)
dyn_half <- process_table(dyn_half, tiers, max_rank = 300)
dyn_non <- select(players, PFF_ID, NAME, TEAM, dynasty_standard_rank, position)
dyn_non <- process_table(dyn_non, tiers, max_rank = 300)
dynrok <- select(players, PFF_ID, NAME, TEAM, dynasty_rookie_rank, position)
dynrok <- process_table(dynrok, tiers, max_rank = 60)
idp_dyn <- select(idp_players, PFF_ID, NAME, TEAM, dynasty_rank, idp_position)
idp_dyn <- process_table(
idp_dyn,
idp_tiers,
position_col = "idp_position",
max_rank = 200
)
idp_dyn_rok <- select(
idp_players,
PFF_ID,
NAME,
TEAM,
dynasty_rookie_rank,
idp_position
)
idp_dyn_rok <- process_table(
idp_dyn_rok,
idp_tiers,
position_col = "idp_position",
max_rank = 12
)
dyn_half_rok <- select(
players,
PFF_ID,
NAME,
TEAM,
dynasty_half_rookie_rank,
position
)
dyn_half_rok <- process_table(dyn_half_rok, tiers, max_rank = 60)
dyn_non_rok <- select(
players,
PFF_ID,
NAME,
TEAM,
dynasty_standard_rookie_rank,
position
)
dyn_non_rok <- process_table(dyn_non_rok, tiers, max_rank = 60)
dynsuper <- select(
players,
PFF_ID,
NAME,
TEAM,
dynasty_superflex_rank,
position
)
dynsuper <- process_table(dynsuper, tiers, max_rank = 300)
dynsuperrok <- select(
players,
PFF_ID,
NAME,
TEAM,
dynasty_superflex_rookie_rank,
position
)
dynsuperrok <- process_table(dynsuperrok, tiers, max_rank = 60)
best <- select(players, PFF_ID, NAME, TEAM, bestball_rank, position)
best <- process_table(best, tiers, max_rank = 150)
ros_ppr <- ros_ppr %>% filter(ppr_rank <= 512) %>% arrange(ppr_rank)
ros_ppr <- select(ros_ppr, PFF_ID, NAME, TEAM, position)
colnames(ros_ppr) <- c('PFF_ID', 'NAME', 'TEAM', 'POSITION')
ros_half <- ros_half %>% filter(half_rank <= 512) %>% arrange(half_rank)
ros_half <- select(ros_half, PFF_ID, NAME, TEAM, position)
colnames(ros_half) <- c('PFF_ID', 'NAME', 'TEAM', 'POSITION')
ros_non <- ros_non %>% filter(standard_rank <= 512) %>% arrange(standard_rank)
ros_non <- select(ros_non, PFF_ID, NAME, TEAM, position)
colnames(ros_non) <- c('PFF_ID', 'NAME', 'TEAM', 'POSITION')
ros_k <- filter(ros_ppr, POSITION == 'K')
ros_def <- filter(ros_ppr, POSITION == 'DEF')
ros_k <- select(ros_k, PFF_ID, NAME, TEAM)
ros_def <- select(ros_def, PFF_ID, NAME, TEAM)
ros_ppr <- filter(ros_ppr, POSITION != 'K' & POSITION != 'DEF')
ros_half <- filter(ros_half, POSITION != 'K' & POSITION != 'DEF')
ros_non <- filter(ros_non, POSITION != 'K' & POSITION != 'DEF')
