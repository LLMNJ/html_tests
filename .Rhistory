'    #pff-cheat-sheet-table .dt-buttons .btn { width: auto !important; display: inline-block; padding: 0.35rem 0.75rem; font-size: 0.875rem; }',
'    #pff-cheat-sheet-table .desktop-btn-label { display: inline; }',
'    #pff-cheat-sheet-table .mobile-btn-label { display: none; }',
'    #pff-cheat-sheet-table #example th, #pff-cheat-sheet-table #example td { text-align: center; }',
'    #pff-cheat-sheet-table #example thead th {',
'      position: sticky;',
'      top: 0;',
'      background-color: #f8f9fa;',
'      z-index: 2;',
