'          <div class="dg-density" role="group" aria-label="Amount of analysis">',
'            <button type="button" class="dg-dbtn" data-density="none" title="Rankings only" aria-label="Rankings only">',
'              <span class="dg-dicon dg-dicon-1"></span></button>',
'            <button type="button" class="dg-dbtn is-active" data-density="brief" title="Short analysis" aria-label="Short analysis">',
'              <span class="dg-dicon dg-dicon-2"></span></button>',
'            <button type="button" class="dg-dbtn" data-density="full" title="Full analysis" aria-label="Full analysis">',
'              <span class="dg-dicon dg-dicon-3"></span></button>',
"          </div>",
'          <select class="dg-select" aria-label="Ranking set">',
ranking_option_html,
"          </select>",
'          <input type="search" class="dg-search" placeholder="Search Player Name" aria-label="Search players">',
"        </div>",
"      </div>",
'      <div class="dg-buttons">',
'        <button type="button" class="dg-btn" data-export="copy"><span class="desktop-btn-label">Copy</span><span class="mobile-btn-label">Copy</span></button>',
'        <button type="button" class="dg-btn" data-export="csv"><span class="desktop-btn-label">Download CSV</span><span class="mobile-btn-label">CSV</span></button>',
'        <button type="button" class="dg-btn" data-export="excel"><span class="desktop-btn-label">Download Excel</span><span class="mobile-btn-label">Excel</span></button>',
'        <button type="button" class="dg-btn" data-export="print"><span class="desktop-btn-label">Print</span><span class="mobile-btn-label">Print</span></button>',
'        <button type="button" class="dg-btn" data-export="clear"><span class="desktop-btn-label">Clear Filters</span><span class="mobile-btn-label">Clear</span></button>',
"      </div>",
'      <p class="dg-count"></p>',
"    </div>",
'    <p class="dg-noresults">No players match that search.</p>',
'    <div class="dg-list">',
player_html,
"    </div>",
"  </div>",
"  <script>",
"  (function () {",
'    var root = document.getElementById("pff-draft-guide");',
"    if (!root) return;",
'    var list = root.querySelector(".dg-list");',
'    var select = root.querySelector(".dg-select");',
'    var search = root.querySelector(".dg-search");',
'    var countEl = root.querySelector(".dg-count");',
'    var pills = Array.prototype.slice.call(root.querySelectorAll(".dg-pill"));',
"",
"    // Parse each player's ranking payload once, then sort in memory and",
"    // re-append the existing nodes rather than rebuilding any markup.",
"    var items = Array.prototype.slice.call(",
'      root.querySelectorAll(".dg-player")',
"    ).map(function (el) {",
"      return {",
"        el: el,",
"        pos: el.dataset.pos,",
'        s: el.dataset.search || "",',
"        rk: JSON.parse(el.dataset.rk),",
'        rankEl: el.querySelector(".dg-rank"),',
'        posRankEl: el.querySelector(".dg-posrank")',
"      };",
"    });",
"",
'    var activePos = "";',
"    // What is currently on screen, in order - every export reads this.",
"    var lastShown = [];",
"",
"    function setActivePos(pos) {",
"      activePos = pos;",
"      pills.forEach(function (p) {",
'        p.classList.toggle("is-active", p.dataset.pos === pos);',
"      });",
"    }",
"",
"    function render() {",
"      var key = select.value;",
"      var q = search.value.trim().toLowerCase();",
"",
"      // Ranked in the chosen set, then narrowed by search.",
"      var ranked = items.filter(function (it) {",
"        if (!(key in it.rk)) return false;",
"        if (q && it.s.indexOf(q) === -1) return false;",
"        return true;",
"      });",
"",
"      // Position counts come from that set, so a pill can be disabled when",
"      // the chosen ranking has nobody at that position.",
"      var counts = {};",
"      ranked.forEach(function (it) {",
"        counts[it.pos] = (counts[it.pos] || 0) + 1;",
"      });",
"      pills.forEach(function (p) {",
"        var pos = p.dataset.pos;",
"        if (!pos) return;",
"        p.disabled = !counts[pos];",
"      });",
"      if (activePos && !counts[activePos]) setActivePos(\"\");",
"",
"      var shown = activePos",
"        ? ranked.filter(function (it) { return it.pos === activePos; })",
"        : ranked;",
"",
"      shown.sort(function (a, b) { return a.rk[key][0] - b.rk[key][0]; });",
"      lastShown = shown;",
"",
"      var frag = document.createDocumentFragment();",
"      var lastTier = null;",
"      shown.forEach(function (it) {",
"        var entry = it.rk[key];",
"        var tier = entry[2];",
"        if (tier !== null && tier !== lastTier) {",
'          var h = document.createElement("div");',
'          h.className = "dg-tier-head";',
'          h.textContent = "Tier " + tier;',
"          frag.appendChild(h);",
"          lastTier = tier;",
"        }",
"        it.rankEl.textContent = entry[0];",
"        it.posRankEl.textContent = it.pos + entry[1];",
"        frag.appendChild(it.el);",
"      });",
"",
"      while (list.firstChild) list.removeChild(list.firstChild);",
"      list.appendChild(frag);",
"",
'      root.classList.toggle("is-empty", shown.length === 0);',
"      countEl.textContent =",
'        shown.length + (shown.length === 1 ? " player" : " players") +',
'        " \\u00b7 " + select.options[select.selectedIndex].text;',
"    }",
"",
"    // Density: purely a class on the root, so switching costs no re-render.",
'    var densityBtns = Array.prototype.slice.call(root.querySelectorAll(".dg-dbtn"));',
"    densityBtns.forEach(function (btn) {",
'      btn.addEventListener("click", function () {',
"        densityBtns.forEach(function (b) {",
'          b.classList.toggle("is-active", b === btn);',
"        });",
'        root.classList.remove("dg-density-none", "dg-density-brief", "dg-density-full");',
'        root.classList.add("dg-density-" + btn.dataset.density);',
"      });",
"    });",
"",
"    // Clicking a row opens the long version whatever the density is. Clicks on",
"    // the player link itself must still follow the link.",
"    function toggleRow(head) {",
'      var art = head.closest(".dg-player");',
"      if (!art) return;",
'      var open = art.classList.toggle("is-open");',
'      head.setAttribute("aria-expanded", open ? "true" : "false");',
"    }",
"",
'    root.addEventListener("click", function (e) {',
'      if (e.target.closest("a")) return;',
'      var head = e.target.closest(".dg-player-head[role=\'button\']");',
"      if (head && root.contains(head)) toggleRow(head);",
"    });",
"",
'    root.addEventListener("keydown", function (e) {',
'      if (e.key !== "Enter" && e.key !== " ") return;',
'      var head = e.target.closest(".dg-player-head[role=\'button\']");',
"      if (!head || !root.contains(head)) return;",
"      e.preventDefault();",
"      toggleRow(head);",
"    });",
"",
'    select.addEventListener("change", render);',
"",
"    pills.forEach(function (pill) {",
'      pill.addEventListener("click", function () {',
"        if (pill.disabled) return;",
"        setActivePos(pill.dataset.pos);",
"        render();",
"        if (root.scrollIntoView) {",
'          root.scrollIntoView({ behavior: "smooth", block: "start" });',
"        }",
"      });",
"    });",
"",
"    var timer = null;",
'    search.addEventListener("input", function () {',
"      clearTimeout(timer);",
"      timer = setTimeout(render, 120);",
"    });",
"",
"",
"// Minimal .xlsx writer: a STORED (uncompressed) zip of the few OOXML parts",
"// Excel needs. Avoids pulling in JSZip + DataTables just to get one button.",
"",
"function dgCrcTable() {",
"  var t = [], c, n, k;",
"  for (n = 0; n < 256; n++) {",
"    c = n;",
"    for (k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);",
"    t[n] = c >>> 0;",
"  }",
"  return t;",
"}",
"var DG_CRC = dgCrcTable();",
"",
"function dgCrc32(bytes) {",
"  var c = 0xFFFFFFFF;",
"  for (var i = 0; i < bytes.length; i++) {",
"    c = DG_CRC[(c ^ bytes[i]) & 0xFF] ^ (c >>> 8);",
"  }",
"  return (c ^ 0xFFFFFFFF) >>> 0;",
"}",
"",
"function dgXmlEsc(s) {",
'  return String(s == null ? "" : s)',
'    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")',
'    .replace(/"/g, "&quot;")',
"    // Strip control chars Excel rejects.",
"    .replace(/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]/g, \"\");",
"}",
"",
"function dgBuildXlsx(headers, rows, sheetName) {",
"  var enc = new TextEncoder();",
'  var colLetters = ["A", "B", "C", "D", "E", "F", "G", "H"];',
"",
"  function cell(ref, val, numeric) {",
"    if (numeric) return '<c r=\"' + ref + '\"><v>' + val + \"</v></c>\";",
"    return '<c r=\"' + ref + '\" t=\"inlineStr\"><is><t xml:space=\"preserve\">' +",
'      dgXmlEsc(val) + "</t></is></c>";',
"  }",
"",
"  var xml = ['<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>',",
"    '<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData>'];",
"",
"  xml.push('<row r=\"1\">' + headers.map(function (h, i) {",
'    return cell(colLetters[i] + "1", h, false);',
'  }).join("") + "</row>");',
"",
"  rows.forEach(function (r, ri) {",
"    var rn = ri + 2;",
"    xml.push('<row r=\"' + rn + '\">' + r.map(function (v, i) {",
"      var isNum = v !== \"\" && v != null && /^-?\\d+(\\.\\d+)?$/.test(String(v));",
"      return cell(colLetters[i] + rn, v, isNum);",
'    }).join("") + "</row>");',
"  });",
'  xml.push("</sheetData></worksheet>");',
"",
"  var parts = [",
'    { name: "[Content_Types].xml", data:',
"      '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +",
"      '<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">' +",
"      '<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>' +",
"      '<Default Extension=\"xml\" ContentType=\"application/xml\"/>' +",
"      '<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>' +",
"      '<Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>' +",
'      "</Types>" },',
'    { name: "_rels/.rels", data:',
"      '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +",
"      '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">' +",
"      '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>' +",
'      "</Relationships>" },',
'    { name: "xl/workbook.xml", data:',
"      '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +",
"      '<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" ' +",
"      'xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">' +",
"      '<sheets><sheet name=\"' + dgXmlEsc(sheetName || \"Sheet1\") +",
"      '\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>' },",
'    { name: "xl/_rels/workbook.xml.rels", data:',
"      '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +",
"      '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">' +",
"      '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/>' +",
'      "</Relationships>" },',
'    { name: "xl/worksheets/sheet1.xml", data: xml.join("") }',
"  ];",
"",
"  var chunks = [], central = [], offset = 0;",
"",
"  function u32(n) {",
"    return [n & 0xFF, (n >>> 8) & 0xFF, (n >>> 16) & 0xFF, (n >>> 24) & 0xFF];",
"  }",
"  function u16(n) { return [n & 0xFF, (n >>> 8) & 0xFF]; }",
"",
"  parts.forEach(function (p) {",
"    var nameBytes = enc.encode(p.name);",
"    var dataBytes = enc.encode(p.data);",
"    var crc = dgCrc32(dataBytes);",
"",
"    var local = [].concat(",
"      u32(0x04034b50), u16(20), u16(0), u16(0), u16(0), u16(0),",
"      u32(crc), u32(dataBytes.length), u32(dataBytes.length),",
"      u16(nameBytes.length), u16(0)",
"    );",
"    chunks.push(new Uint8Array(local), nameBytes, dataBytes);",
"",
"    central.push([].concat(",
"      u32(0x02014b50), u16(20), u16(20), u16(0), u16(0), u16(0), u16(0),",
"      u32(crc), u32(dataBytes.length), u32(dataBytes.length),",
"      u16(nameBytes.length), u16(0), u16(0), u16(0), u16(0), u32(0), u32(offset)",
"    ), nameBytes);",
"",
"    offset += local.length + nameBytes.length + dataBytes.length;",
"  });",
"",
"  var cdStart = offset, cdSize = 0, cdChunks = [];",
"  for (var i = 0; i < central.length; i += 2) {",
"    var hdr = new Uint8Array(central[i]);",
"    cdChunks.push(hdr, central[i + 1]);",
"    cdSize += hdr.length + central[i + 1].length;",
"  }",
"  cdChunks.push(new Uint8Array([].concat(",
"    u32(0x06054b50), u16(0), u16(0), u16(parts.length), u16(parts.length),",
"    u32(cdSize), u32(cdStart), u16(0)",
"  )));",
"",
"  var all = chunks.concat(cdChunks);",
"  var total = all.reduce(function (s, a) { return s + a.length; }, 0);",
"  var out = new Uint8Array(total), pos = 0;",
"  all.forEach(function (a) { out.set(a, pos); pos += a.length; });",
"  return out;",
"}",
"",
"",
"",
"// --- Exports: Copy / CSV / Excel / Print, mirroring the cheat sheet ---------",
"// Columns are exactly the cheat sheet's: Rank, Position, Name, Team. Every",
"// export reflects the ranking, position filter and search currently applied.",
"",
"function dgExportTitle() {",
'  return "PFF " + select.options[select.selectedIndex].text + " Draft Guide";',
"}",
"",
"function dgExportFilename() {",
"  return dgExportTitle().replace(/\\s+/g, \"_\").toLowerCase();",
"}",
"",
'var DG_HEADERS = ["Rank", "Position", "Name", "Team"];',
"",
"function dgExportRows() {",
"  var key = select.value;",
"  return lastShown.map(function (it) {",
"    return [",
"      String(it.rk[key][0]),",
"      it.pos,",
'      it.el.querySelector(".dg-name").textContent.trim(),',
'      it.el.querySelector(".dg-team").textContent.trim()',
"    ];",
"  });",
"}",
"",
"function dgDownload(bytes, mime, filename) {",
"  var blob = new Blob([bytes], { type: mime });",
"  var url = URL.createObjectURL(blob);",
'  var a = document.createElement("a");',
"  a.href = url;",
"  a.download = filename;",
"  document.body.appendChild(a);",
"  a.click();",
"  document.body.removeChild(a);",
"  setTimeout(function () { URL.revokeObjectURL(url); }, 1000);",
"}",
"",
"function dgCopy() {",
"  var lines = [DG_HEADERS.join(\"\\t\")];",
"  dgExportRows().forEach(function (r) { lines.push(r.join(\"\\t\")); });",
"  var text = lines.join(\"\\n\");",
"",
"  function fallback() {",
'    var ta = document.createElement("textarea");',
"    ta.value = text;",
'    ta.setAttribute("readonly", "");',
'    ta.style.position = "fixed";',
'    ta.style.top = "-1000px";',
"    document.body.appendChild(ta);",
"    ta.select();",
'    try { document.execCommand("copy"); } catch (e) {}',
"    document.body.removeChild(ta);",
"  }",
"",
"  if (navigator.clipboard && window.isSecureContext) {",
"    navigator.clipboard.writeText(text).catch(fallback);",
"  } else {",
"    fallback();",
"  }",
'  dgFlash("copy", "Copied");',
"}",
"",
"function dgCsv() {",
"  function q(v) { return '\"' + String(v).replace(/\"/g, '\"\"') + '\"'; }",
'  var lines = [DG_HEADERS.map(q).join(",")];',
'  dgExportRows().forEach(function (r) { lines.push(r.map(q).join(",")); });',
"  // BOM so Excel opens UTF-8 names (St. Brown, Ja'Marr) correctly.",
"  dgDownload(\"﻿\" + lines.join(\"\\n\"), \"text/csv;charset=utf-8\", dgExportFilename() + \".csv\");",
"}",
"",
"function dgExcel() {",
"  dgDownload(",
'    dgBuildXlsx(DG_HEADERS, dgExportRows(), "Rankings"),',
'    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",',
'    dgExportFilename() + ".xlsx"',
"  );",
"}",
"",
"function dgPrint() {",
"  var printTitle = dgExportTitle();",
"  var columnsPerPage = 3;",
"  var rowsPerColumn = 85;",
'  var headers = ["Rank", "Pos", "Name", "Team"];',
"  var rows = dgExportRows();",
"",
"  function esc(x) {",
'    return String(x == null ? "" : x)',
'      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");',
"  }",
"",
"  function makeMiniTable(rowsChunk) {",
"    if (!rowsChunk.length) return '<div class=\"print-column empty-column\"></div>';",
"    var html = '<div class=\"print-column\"><table class=\"print-mini-table\"><thead><tr>';",
'    headers.forEach(function (h) { html += "<th>" + esc(h) + "</th>"; });',
'    html += "</tr></thead><tbody>";',
"    rowsChunk.forEach(function (row) {",
'      html += "<tr>";',
'      row.forEach(function (cell) { html += "<td>" + esc(cell) + "</td>"; });',
'      html += "</tr>";',
"    });",
'    return html + "</tbody></table></div>";',
"  }",
"",
'  var body = "";',
"  var rowsPerPage = columnsPerPage * rowsPerColumn;",
"  for (var i = 0; i < rows.length; i += rowsPerPage) {",
"    body += '<div class=\"print-page-wrapper\"><div class=\"print-title\">' +",
"      esc(printTitle) + '</div><div class=\"print-page\">';",
"    for (var c = 0; c < columnsPerPage; c++) {",
"      var start = i + c * rowsPerColumn;",
"      body += makeMiniTable(rows.slice(start, start + rowsPerColumn));",
"    }",
'    body += "</div></div>";',
"  }",
"",
'  var css = "@page { size: portrait; margin: 0.12in; }" +',
'    "body { font-family: Archivo, Arial, sans-serif; margin: 0; color: #000; }" +',
'    ".print-title { font-size: 11pt; font-weight: 700; text-align: center; margin-bottom: 5px; }" +',
'    ".print-page-wrapper { page-break-after: always; break-after: page; }" +',
'    ".print-page-wrapper:last-child { page-break-after: auto; break-after: auto; }" +',
'    ".print-page { display: flex; gap: 8px; width: 100%; align-items: flex-start; }" +',
'    ".print-column { width: 33.333%; }" +',
'    ".empty-column { display: block; }" +',
'    ".print-mini-table { width: 100%; border-collapse: collapse; table-layout: fixed; }" +',
'    ".print-mini-table th, .print-mini-table td { font-size: 7.2pt; line-height: 1.03; padding: 0.4px 0.65px; border-bottom: 0.2px solid #ddd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }" +',
'    ".print-mini-table th { font-weight: 700; border-bottom: 0.5px solid #999; text-align: center; }" +',
'    ".print-mini-table th:nth-child(1), .print-mini-table td:nth-child(1) { width: 12%; text-align: center; }" +',
'    ".print-mini-table th:nth-child(2), .print-mini-table td:nth-child(2) { width: 12%; text-align: center; }" +',
'    ".print-mini-table th:nth-child(3), .print-mini-table td:nth-child(3) { width: 47%; text-align: left; }" +',
'    ".print-mini-table th:nth-child(4), .print-mini-table td:nth-child(4) { width: 29%; text-align: left; }";',
"",
'  var win = window.open("about:blank", "_blank");',
'  if (!win) { dgFlash("print", "Popup blocked"); return; }',
"  win.document.open();",
"  win.document.write(\"<!DOCTYPE html><html><head><meta charset='utf-8'><title>\" +",
'    esc(printTitle) + "</title><style>" + css + "</style></head><body>" + body +',
'    "</body></html>");',
"  win.document.close();",
"  win.focus();",
"  setTimeout(function () { win.print(); }, 250);",
"}",
"",
"function dgClearFilters() {",
'  search.value = "";',
'  setActivePos("");',
"  render();",
"}",
"",
"// Brief label swap so a click gives visible feedback.",
"function dgFlash(action, msg) {",
"  var btn = root.querySelector('.dg-btn[data-export=\"' + action + '\"]');",
"  if (!btn) return;",
'  var label = btn.querySelector(".desktop-btn-label");',
"  if (!label) return;",
"  var original = label.textContent;",
"  label.textContent = msg;",
"  setTimeout(function () { label.textContent = original; }, 1200);",
"}",
"",
'root.addEventListener("click", function (e) {',
'  var btn = e.target.closest(".dg-btn");',
"  if (!btn || !root.contains(btn)) return;",
"  var action = btn.dataset.export;",
'  if (action === "copy") dgCopy();',
'  else if (action === "csv") dgCsv();',
'  else if (action === "excel") dgExcel();',
'  else if (action === "print") dgPrint();',
'  else if (action === "clear") dgClearFilters();',
"});",
"",
"    render();",
"  })();",
"  </script>",
"</body>",
"</html>"
)
# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# One file, carrying every ranking - so it is no longer named after one.
page_basename <- "draft_guide.html"
for (dir in output_dirs) {
writeLines(html_lines, file.path(dir, page_basename))
}
message(
"Wrote ", page_basename, " (", length(included), " players, ",
length(ranking_defs), " rankings) to:\n  ",
paste(output_dirs, collapse = "\n  ")
)
setwd(git_dir)
if (push_to_git) {
gert::git_add(".")
# Re-running without changing the sheets regenerates a byte-identical file,
# which stages nothing and makes git_commit() error out. Only commit when
# there is actually something staged, but still push in case an earlier
# commit was made and the push didn't go through.
if (nrow(gert::git_status(staged = TRUE)) > 0) {
gert::git_commit("Update draft guide HTML")
} else {
message("html_tests: embed file unchanged, nothing new to commit.")
}
gert::git_push(remote = "origin")
}
