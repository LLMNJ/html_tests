"DL"
} else if (
grepl("Defensive Back Cheat Sheet", article_title, ignore.case = TRUE)
) {
"DB"
} else {
"All"
}
table_title <- paste("PFF ", league_type, " Cheat Sheet", sep = "")
csv_filename <- gsub("\\s+", "_", tolower(table_title)) # e.g., "cheat_sheet"
url <-
"https://docs.google.com/spreadsheets/d/1KbwN3IDUxRzDx9vCMz2Xe4o3eQj7574wFCbW8VrdeFw/edit#gid=80961760"
players <- read_sheet(url, sheet = "players")
teams <- read_sheet(url, sheet = "teams")
idp_players <- read_sheet(url, sheet = "idp_players")
players <- left_join(
x = players,
y = teams,
by = c("current_team" = "team_last_name...2")
)
idp_players <- left_join(
x = idp_players,
y = teams,
by = c("current_team" = "team_last_name...2")
)
players <- players %>%
mutate(
rank = case_when(
league_type == "PPR" ~ players$ppr_rank,
league_type == "half" ~ players$half_rank,
league_type == "standard" ~ players$standard_rank,
league_type == "superflex" ~ players$superflex_rank,
league_type == "TE premium" ~ players$te_premium_rank,
league_type == "dynasty" ~ players$dynasty_rank,
league_type == "dynasty superflex" ~ players$dynasty_superflex_rank,
league_type == "dynasty TE premium" ~ players$dynasty_te_premium_rank,
league_type == "dynasty rookie" ~ players$dynasty_rookie_rank,
league_type == "dynasty TE premium rookie" ~
players$dynasty_te_premium_rookie_rank,
league_type == "dynasty rookie superflex" ~
players$dynasty_superflex_rookie_rank,
TRUE ~ players$ppr_rank
)
)
if (is_idp | article_position %in% c('DL', 'LB', 'DB')) {
players <- idp_players %>%
mutate(
rank = case_when(
league_type == "dynasty" ~ idp_players$dynasty_rank,
league_type == "dynasty rookie" ~ idp_players$dynasty_rookie_rank,
TRUE ~ idp_players$rank
)
)
players$position <- players$idp_position
}
players$player_profile_url <- ifelse(
is.na(
players$player_profile_url
),
players$pff_player_url,
players$player_profile_url
)
intro_url <- "https://docs.google.com/spreadsheets/d/1uxdGbYoGFdQKEldPEgucNVIR1E_bFfxFEf8Dx0nclII/edit?gid=0#gid=0"
schedule <- read_sheet(intro_url, sheet = "schedule")
intros <- read_sheet(intro_url, sheet = "intros")
schedule <- schedule %>% filter(title == article_title)
intros <- intros %>% filter(title == article_title)
publish_day_of_week <- schedule[[1, 3]]
publish_month <- schedule[[1, 1]]
publish_day <- schedule[[1, 2]]
intro_text <- intros[[1, 8]]
bullet_bold_one <- paste(intros[[1, 2]], ":", sep = "")
bullet_text_one <- intros[[1, 3]]
bullet_bold_two <- paste(intros[[1, 4]], ":", sep = "")
bullet_text_two <- intros[[1, 5]]
bullet_bold_three <- paste(intros[[1, 6]], ":", sep = "")
bullet_text_three <- intros[[1, 7]]
bullets <- list(
list(prefix = bullet_bold_one, body = bullet_text_one),
list(prefix = bullet_bold_two, body = bullet_text_two),
list(prefix = bullet_bold_three, body = bullet_text_three)
)
players <- select(
players,
rank,
position,
name,
current_team,
player_profile_url,
url
)
if (
article_position != "All" &
article_position != 'DL' &
article_position != 'DB'
) {
players <- filter(players, players$position == article_position)
players <- players %>% mutate(rank = dense_rank(rank))
}
if (article_position == 'DL') {
players <- filter(players, players$position %in% c('DE', 'DT'))
players <- players %>% mutate(rank = dense_rank(rank))
}
if (article_position == "DB") {
players <- filter(players, players$position %in% c('CB', 'S'))
players <- players %>% mutate(rank = dense_rank(rank))
}
players <- filter(players, players$rank <= number_of_players) %>%
arrange(rank)
# Build <tbody> rows from dataframe
rows <- apply(players, 1, function(r) {
glue(
'<tr>\n',
'  <td>{r["rank"]}</td>\n',
'  <td>{r["position"]}</td>\n',
'  <td><a href="{r["player_profile_url"]}">{r["name"]}</a></td>\n',
'  <td><a href="{r["url"]}">{r["current_team"]}</a></td>\n',
'</tr>'
)
})
tbody_html <- paste(rows, collapse = "\n")
# Construct full HTML inline
html_lines <- c(
'<!DOCTYPE html>',
'<html lang="en">',
'<head>',
'  <meta charset="UTF-8">',
'  <meta name="viewport" content="width=device-width, initial-scale=1">',
sprintf('  <title>%s</title>', table_title),
'  <link href="https://fonts.googleapis.com/css2?family=Archivo&display=swap" rel="stylesheet">',
'  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">',
'  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">',
'  <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">',
'  <style>',
"    #pff-cheat-sheet-table, #pff-cheat-sheet-table table { font-family: 'Archivo', sans-serif; }",
