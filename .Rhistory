'      z-index: 2;',
'    }',
'    #pff-cheat-sheet-table #example thead tr.filter-row th {',
'      top: 38px;',
'      z-index: 1;',
'    }',
'    #pff-cheat-sheet-table #example .filter-row input, #pff-cheat-sheet-table #example .filter-row select { width: 100%; box-sizing: border-box; text-align: center; }',
'    #pff-cheat-sheet-table #example a { color: #0d6efd; text-decoration: none; }',
'    #pff-cheat-sheet-table #example a:hover { text-decoration: underline; }',
'    #pff-cheat-sheet-table .dataTables_filter { display: none; }',
'    #pff-cheat-sheet-table .desktop-label { display: inline; }',
'    #pff-cheat-sheet-table .mobile-label { display: none; }',
'    @media (max-width: 576px) {',
'      #pff-cheat-sheet-table .cheat-controls { gap: 8px; }',
'      #pff-cheat-sheet-table .cheat-control { min-width: 140px; flex: 1 1 140px; }',
'      #pff-cheat-sheet-table .cheat-heading { font-size: 1rem; }',
'      #pff-cheat-sheet-table .dt-buttons { gap: 4px; margin-bottom: 8px; }',
'      #pff-cheat-sheet-table .dt-buttons .btn { padding: 0.25rem 0.45rem; font-size: 0.75rem; }',
'      #pff-cheat-sheet-table .desktop-btn-label { display: none; }',
'      #pff-cheat-sheet-table .mobile-btn-label { display: inline; }',
'      #pff-cheat-sheet-table #example { table-layout: fixed; width: 100%; }',
'      #pff-cheat-sheet-table #example th, #pff-cheat-sheet-table #example td { font-size: 12px; padding: 2px; }',
'      #pff-cheat-sheet-table #example th:nth-child(1), #pff-cheat-sheet-table #example td:nth-child(1) {',
'        width: 8%; max-width: 30px; white-space: nowrap; text-align: left; padding-right: 12px;',
'      }',
'      #pff-cheat-sheet-table #example th:nth-child(2), #pff-cheat-sheet-table #example td:nth-child(2) {',
'        width: 10%; max-width: 35px; white-space: nowrap; text-align: left; padding-right: 12px;',
'      }',
'      #pff-cheat-sheet-table #example th:nth-child(3), #pff-cheat-sheet-table #example td:nth-child(3) {',
'        width: 35%; max-width: 100px; word-wrap: break-word; white-space: normal;',
'      }',
'      #pff-cheat-sheet-table #example th:nth-child(4), #pff-cheat-sheet-table #example td:nth-child(4) {',
'        width: 30%; max-width: 70px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;',
'      }',
'      #pff-cheat-sheet-table .desktop-label { display: none; }',
'      #pff-cheat-sheet-table .mobile-label { display: inline; }',
'    }',
'    @media print {',
'      #pff-cheat-sheet-table .cheat-controls, #pff-cheat-sheet-table .dt-buttons, #pff-cheat-sheet-table #example thead tr.filter-row { display: none !important; }',
'      body { padding: 0 !important; }',
'      #pff-cheat-sheet-table #example { table-layout: fixed; width: 100%; }',
'      #pff-cheat-sheet-table #example th, #pff-cheat-sheet-table #example td { font-size: 6pt; line-height: 1.02; padding: 1px 2px; }',
'      #pff-cheat-sheet-table #example a { color: #000; text-decoration: none; }',
'    }',
'  </style>',
'</head>',
'<body class="p-4">',
'  <div id="pff-cheat-sheet-table">',
'    <div class="cheat-controls">',
'      <div class="cheat-control">',
'        <label for="league-select">League Type</label>',
'        <select id="league-select" class="form-select form-select-sm"></select>',
'      </div>',
'      <div class="cheat-control">',
'        <label for="position-select">Position</label>',
'        <select id="position-select" class="form-select form-select-sm"></select>',
'      </div>',
'    </div>',
'    <h2 id="cheat-heading" class="cheat-heading"></h2>',
'    <div class="table-responsive">',
'      <table id="example" class="table table-striped table-hover">',
'        <thead class="table-light">',
'          <tr>',
'            <th><span class="desktop-label">Rank</span><span class="mobile-label">Rk.</span></th>',
'            <th><span class="desktop-label">Position</span><span class="mobile-label">Pos.</span></th>',
'            <th>Name</th>',
'            <th>Team</th>',
'          </tr>',
'          <tr class="filter-row">',
'            <th></th>',
'            <th></th>',
'            <th><input type="text" class="form-control form-control-sm text-center" placeholder="Filter"></th>',
'            <th></th>',
'          </tr>',
'        </thead>',
'        <tbody></tbody>',
'      </table>',
'    </div>',
'  </div>',
'  <script id="pff-cheat-data" type="application/json">',
payload_json,
'  </script>',
'  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>',
'  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>',
'  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>',
'  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>',
'  <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>',
'  <script>',
'    $(document).ready(function() {',
'',
'      var DATA = JSON.parse(document.getElementById("pff-cheat-data").textContent);',
'      var $league = $("#league-select");',
'      var $position = $("#position-select");',
'',
'      function escapeHtml(x) {',
'        return $("<div>").text(x == null ? "" : x).html();',
'      }',
'',
'      function asArray(x) {',
'        if (x == null) return [];',
'        return Array.isArray(x) ? x : [x];',
'      }',
'',
'      function link(href, text) {',
'        var label = escapeHtml(text);',
'        if (!href) return label;',
'        return "<a href=\\"" + escapeHtml(href) + "\\">" + label + "</a>";',
'      }',
'',
'      function currentLeague() {',
'        var id = $league.val();',
'        for (var i = 0; i < DATA.leagues.length; i++) {',
'          if (DATA.leagues[i].id === id) return DATA.leagues[i];',
'        }',
'        return DATA.leagues[0];',
'      }',
'',
'      function groupsForLeague(lg) {',
'        return DATA.positions[lg.pool];',
'      }',
'',
'      function currentGroup() {',
'        var groups = groupsForLeague(currentLeague());',
'        var id = $position.val();',
'        for (var i = 0; i < groups.length; i++) {',
'          if (groups[i].id === id) return groups[i];',
'        }',
'        return groups[0];',
'      }',
'',
'      function tableTitle() {',
'        var lg = currentLeague();',
'        var grp = currentGroup();',
'        if (grp.id === "All") return "PFF " + lg.label + " Cheat Sheet";',
'        return "PFF " + lg.label + " " + grp.label + " Cheat Sheet";',
'      }',
'',
'      function exportFilename() {',
'        return tableTitle().toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");',
'      }',
'',
'      // Populate the league dropdown once.',
'      $.each(DATA.leagues, function(_, lg) {',
'        $league.append($("<option>").val(lg.id).text(lg.label));',
'      });',
'      $league.val(DATA.defaultLeague);',
'      if (!$league.val()) $league.val(DATA.leagues[0].id);',
'',
'      // The position options depend on which pool the league type uses,',
'      // so they get rebuilt whenever the league changes.',
'      function buildPositionOptions(preferredId) {',
'        var groups = groupsForLeague(currentLeague());',
'        var previous = preferredId || $position.val();',
'        $position.empty();',
'        $.each(groups, function(_, g) {',
'          $position.append($("<option>").val(g.id).text(g.label));',
'        });',
'        $position.val(previous);',
'        if (!$position.val()) $position.val(groups[0].id);',
'      }',
'',
'      buildPositionOptions(DATA.defaultPosition);',
'',
'      // Filter, sort, re-rank and cut to the configured depth.',
'      function buildRows() {',
'        var lg = currentLeague();',
'        var grp = currentGroup();',
'        var members = asArray(grp.members);',
'        var col = lg.column;',
'        var limit = Math.min(lg.count, grp.count);',
'',
'        var rows = DATA.pools[lg.pool].filter(function(p) {',
'          return p[col] !== null && p[col] !== undefined && members.indexOf(p.position) !== -1;',
'        });',
'',
'        rows.sort(function(a, b) { return a[col] - b[col]; });',
'',
'        var out = [];',
'        var lastValue = null;',
'        var rank = 0;',
'        for (var i = 0; i < rows.length; i++) {',
'          if (rows[i][col] !== lastValue) {',
'            rank = rank + 1;',
'            lastValue = rows[i][col];',
'          }',
'          if (rank > limit) break;',
'          out.push({ rank: rank, player: rows[i] });',
'        }',
'        return out;',
'      }',
'',
'      function dtExportText(data) {',
'        try {',
'          return $("<div>").html(data).text().trim();',
'        } catch(e) {',
'          return (data || "").toString().trim();',
'        }',
'      }',
'',
'      function dtExportHeader(data, columnIdx, node) {',
'        var desktopLabel = $(node).find(".desktop-label").text();',
'        return desktopLabel || $(node).text().trim();',
'      }',
'',
'      var table = $("#example").DataTable({',
'        dom: "B t",',
'        autoWidth: false,',
'        deferRender: true,',
'        columnDefs: [',
'          { targets: 0, width: "8%" },',
'          { targets: 1, width: "10%" },',
'          { targets: 2, width: "35%" },',
'          { targets: 3, width: "30%" }',
'        ],',
'        buttons: [',
'          {',
'            extend: "copyHtml5",',
'            text: "<span class=\\"desktop-btn-label\\">Copy</span><span class=\\"mobile-btn-label\\">Copy</span>",',
'            title: function() { return tableTitle(); },',
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            }',
'          },',
'          {',
'            extend: "csvHtml5",',
'            text: "<span class=\\"desktop-btn-label\\">Download CSV</span><span class=\\"mobile-btn-label\\">CSV</span>",',
'            filename: function() { return exportFilename(); },',
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            }',
'          },',
'          {',
'            extend: "excelHtml5",',
'            text: "<span class=\\"desktop-btn-label\\">Download Excel</span><span class=\\"mobile-btn-label\\">Excel</span>",',
'            filename: function() { return exportFilename(); },',
'            title: function() { return tableTitle(); },',
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            }',
'          },',
'          {',
'            extend: "print",',
'            text: "<span class=\\"desktop-btn-label\\">Print</span><span class=\\"mobile-btn-label\\">Print</span>",',
'            title: "",',
'            exportOptions: {',
'              columns: ":visible",',
'              modifier: { search: "applied", order: "applied" },',
'              format: { header: dtExportHeader, body: dtExportText }',
'            },',
'            customize: function(win) {',
'              var printTitle = tableTitle();',
'              win.document.title = printTitle;',
'              var columnsPerPage = 3;',
'              var rowsPerColumn = 80;',
'              var rowsPerPage = columnsPerPage * rowsPerColumn;',
'              var $body = $(win.document.body);',
'              var $originalTable = $body.find("table").first();',
'',
'              var headers = [];',
'              $originalTable.find("thead tr").first().find("th").each(function(i) {',
'                if (i === 0) headers.push("Rank");',
'                else if (i === 1) headers.push("Pos");',
'                else headers.push($(this).text().trim());',
'              });',
'',
'              var rows = [];',
'              $originalTable.find("tbody tr").each(function() {',
'                var row = [];',
'                $(this).find("td").each(function() {',
'                  row.push($(this).text().trim());',
'                });',
'                if (row.length) rows.push(row);',
'              });',
'',
'              function makeMiniTable(headers, rowsChunk) {',
'                if (!rowsChunk.length) return "<div class=\\"print-column empty-column\\"></div>";',
'                var html = "<div class=\\"print-column\\"><table class=\\"print-mini-table\\"><thead><tr>";',
'                headers.forEach(function(h) { html += "<th>" + escapeHtml(h) + "</th>"; });',
'                html += "</tr></thead><tbody>";',
'                rowsChunk.forEach(function(row) {',
'                  html += "<tr>";',
'                  row.forEach(function(cell) { html += "<td>" + escapeHtml(cell) + "</td>"; });',
'                  html += "</tr>";',
'                });',
'                html += "</tbody></table></div>";',
'                return html;',
'              }',
'',
'              var html = "";',
'',
'              for (var i = 0; i < rows.length; i += rowsPerPage) {',
'                html += "<div class=\\"print-page-wrapper\\">";',
'                html += "<div class=\\"print-title\\">" + escapeHtml(printTitle) + "</div>";',
'                html += "<div class=\\"print-page\\">";',
'                for (var c = 0; c < columnsPerPage; c++) {',
'                  var start = i + c * rowsPerColumn;',
'                  var end = start + rowsPerColumn;',
'                  html += makeMiniTable(headers, rows.slice(start, end));',
'                }',
'                html += "</div>";',
'                html += "</div>";',
'              }',
'',
'              $body.html(html);',
'',
'              $(win.document.head).append(',
'                "<style>" +',
'                "@page { size: portrait; margin: 0.12in; }" +',
'                "body { font-family: Archivo, Arial, sans-serif; margin: 0; color: #000; }" +',
'                ".print-title { font-size: 11pt; font-weight: 700; text-align: center; margin-bottom: 5px; }" +',
'                ".print-page-wrapper { page-break-after: always; break-after: page; }" +',
'                ".print-page-wrapper:last-child { page-break-after: auto; break-after: auto; }" +',
'                ".print-page { display: flex; gap: 8px; width: 100%; align-items: flex-start; }" +',
'                ".print-column { width: 33.333%; }" +',
'                ".empty-column { display: block; }" +',
'                ".print-mini-table { width: 100%; border-collapse: collapse; table-layout: fixed; }" +',
'                ".print-mini-table th, .print-mini-table td { font-size: 7.2pt; line-height: 1.03; padding: 0.4px 0.65px; border-bottom: 0.2px solid #ddd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }" +',
'                ".print-mini-table th { font-weight: 700; border-bottom: 0.5px solid #999; text-align: center; }" +',
'                ".print-mini-table th:nth-child(1), .print-mini-table td:nth-child(1) { width: 12%; text-align: center; }" +',
'                ".print-mini-table th:nth-child(2), .print-mini-table td:nth-child(2) { width: 12%; text-align: center; }" +',
'                ".print-mini-table th:nth-child(3), .print-mini-table td:nth-child(3) { width: 47%; text-align: left; }" +',
'                ".print-mini-table th:nth-child(4), .print-mini-table td:nth-child(4) { width: 29%; text-align: left; }" +',
'                "</style>"',
'              );',
'            }',
'          },',
'          {',
'            text: "<span class=\\"desktop-btn-label\\">Clear Filters</span><span class=\\"mobile-btn-label\\">Clear</span>",',
'            action: function() {',
'              clearFilters();',
'            }',
'          }',
'        ],',
'        paging: false,',
'        ordering: true,',
'        info: false,',
'        orderCellsTop: true',
'      });',
'',
'      // Open player/team links in a new tab',
'      function retargetLinks() {',
'        $("#pff-cheat-sheet-table #example a").attr("target", "_blank").attr("rel", "noopener noreferrer");',
'      }',
'      table.on("draw", retargetLinks);',
'',
'      // Prevent clicks inside filter controls from triggering column sorting',
'      $("#pff-cheat-sheet-table #example thead tr.filter-row").on("click", "input, select", function(e) {',
'        e.stopPropagation();',
'      });',
'',
'      // name filter input (column 2)',
'      $("#pff-cheat-sheet-table .filter-row input").on("keyup change", function() {',
'        table.column(2).search(this.value).draw();',
'      });',
'',
'      function clearFilters() {',
'        $("#pff-cheat-sheet-table .filter-row input").val("");',
'        $("#pff-cheat-sheet-table .filter-row select").val("");',
'        table.search("").columns().search("");',
'        table.draw();',
'      }',
'',
'      // Dropdowns for position and team. These get rebuilt after every',
'      // render because the available values change with the league type.',
'      function addDropdown(colIndex, placeholder) {',
'        var $cell = $("#pff-cheat-sheet-table #example .filter-row th").eq(colIndex);',
'        $cell.find("select").remove();',
'',
'        var col = table.column(colIndex);',
'        var vals = col.data().map(function(d) { return $("<div>").html(d).text(); }).toArray();',
'        vals = Array.from(new Set(vals)).sort();',
'',
'        var sel = $("<select class=\\"form-select form-select-sm text-center\\"></select>");',
'        sel.append($("<option>").val("").text(placeholder));',
'        $.each(vals, function(_, v) { sel.append($("<option>").val(v).text(v)); });',
'        sel.on("change", function() {',
'          col.search(this.value ? "^" + this.value + "$" : "", true, false).draw();',
'        });',
'        $cell.append(sel);',
'      }',
'',
'      function refreshDropdowns() {',
'        addDropdown(1, "Filter");',
'        addDropdown(3, "Filter");',
'      }',
'',
'      // Rebuild the table body for the current dropdown selections.',
'      function render() {',
'        var rows = buildRows();',
'',
'        table.search("").columns().search("");',
'        $("#pff-cheat-sheet-table .filter-row input").val("");',
'',
'        table.clear();',
'        rows.forEach(function(item) {',
'          var p = item.player;',
'          table.row.add([',
'            item.rank,',
'            escapeHtml(p.position),',
'            link(p.player_profile_url, p.name),',
'            link(p.url, p.current_team)',
'          ]);',
'        });',
'        table.order([0, "asc"]).draw();',
'',
'        refreshDropdowns();',
'        retargetLinks();',
'',
'        var title = tableTitle();',
'        document.title = title;',
'        $("#cheat-heading").html(',
'          escapeHtml(title) +',
'          "<span class=\\"cheat-count\\">" + rows.length + " players</span>"',
'        );',
'      }',
'',
'      $league.on("change", function() {',
'        buildPositionOptions();',
'        render();',
'      });',
'',
'      $position.on("change", render);',
'',
'      render();',
'    });',
'  </script>',
'</body>',
'</html>'
)
file_name <- "/home/nathan/Dropbox/403_article_creation/html/cheat_sheet_html_interactive.html"
writeLines(html_lines, file_name)
# ---------------------------------------------------------------------------
# Google Doc friendly version. Still a single static table, built from the
# default league type and position set at the top.
# ---------------------------------------------------------------------------
table_title <- "2026 PFF Fantasy Football Cheat Sheet"
players_static <- build_table(default_league, default_position)
intro_section <- tagList(
tags$ul(
style = "font-family:sans-serif; font-size:11pt;",
lapply(bullets, function(b) tags$li(tags$b(b$prefix), " ", b$body))
),
tags$p(
style = "font-family:sans-serif; font-size:11pt; margin-bottom:1em;",
intro_text
),
tags$p(
style = "font-family:sans-serif; font-size:11pt; margin-bottom:1em;",
tags$b(paste0(
"Last updated: ",
publish_day_of_week,
", ",
publish_month,
" ",
publish_day
))
)
)
cell_style <- "border:1px solid #999; padding:4px 8px; font-family:sans-serif; font-size:11pt;"
head_style <- paste0(cell_style, " font-weight:bold; background-color:#f2f2f2;")
table_rows <- pmap(
players_static,
function(rank, position, name, current_team, player_profile_url, url, ...) {
tags$tr(
tags$td(style = cell_style, rank),
tags$td(style = cell_style, position),
tags$td(style = cell_style, tags$a(href = player_profile_url, name)),
tags$td(style = cell_style, tags$a(href = url, current_team))
)
}
)
simple_table <- tags$table(
style = "border:1px solid #999; border-collapse:collapse;",
tags$thead(
tags$tr(
tags$th(style = head_style, "Rank"),
tags$th(style = head_style, "Position"),
tags$th(style = head_style, "Name"),
tags$th(style = head_style, "Team")
)
),
tags$tbody(table_rows)
)
doc_gdoc <- tags$html(
tags$head(
tags$meta(charset = "UTF-8"),
tags$title(table_title)
),
tags$body(
intro_section,
simple_table
)
)
gdoc_file_name <- "/home/nathan/Dropbox/403_article_creation/html/2026_cheat_sheet_doc.html"
save_html(doc_gdoc, gdoc_file_name)
# ---------------------------------------------------------------------------
# Copy to the test directory and push
# ---------------------------------------------------------------------------
setwd("~/html_tests")
writeLines(html_lines, "~/html_tests/cheat_sheet_html_interactive.html")
gert::git_add(".") # stage everything
gert::git_commit("Update HTML") # commit staged files
gert::git_push(remote = "origin")
